^ parser.mish
^ A recursive AST-building parser written in MidShake.
^ It reads source code, splits it into lines, and builds AST nodes as nested maps.
^ Each AST node is a map with "type", "name", "value", "body", and "children" properties.
^ Block statements (IF, WHILST, DEFINE, FOR) recursively parse their body lines into proper child AST nodes.
^ Uses GLOBAL SET to share state across recursive function calls.

IMPORT the file "stdlib/stdlib.mish";

^ ====== Global State ======
^ These variables are shared across recursive calls to parseStatement using GLOBAL SET.
LET the variable g_lines BE [];
LET the variable g_pos BE the number 0;
LET the variable g_lineCount BE the number 0;
LET the variable g_ast BE [];
^ g_result holds the return value of parseStatement, shared via GLOBAL SET
LET the variable g_result BE {};

^ ====== Helper Functions ======

^ Create an AST node map with a given type
DEFINE function createNode WITH the variable nodeType;
    LET the variable node BE {};
    SET the key "type" IN the map node TO the value of nodeType;
    SET the key "body" IN the map node TO [];
    SET the key "children" IN the map node TO [];
    RETURN the value of node;
END FUNCTION;

^ Extract the variable name from a LET statement
DEFINE function extractLetName WITH the variable line;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable name BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            CALL trim WITH the value of word;
            LET the variable trimmedWord BE the RESPONSE;
            IF the length of trimmedWord IS greater than the number 0 THEN
                SET the variable name TO the value of trimmedWord;
                SET the variable found TO the number 2;
            END IF;
        END IF;
        
        IF the value of word IS equal to the string "variable" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of name;
END FUNCTION;

^ Extract the variable name from a SET statement
DEFINE function extractSetName WITH the variable line;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable name BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            CALL trim WITH the value of word;
            LET the variable trimmedWord BE the RESPONSE;
            IF the length of trimmedWord IS greater than the number 0 THEN
                SET the variable name TO the value of trimmedWord;
                SET the variable found TO the number 2;
            END IF;
        END IF;
        
        IF the value of word IS equal to the string "variable" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of name;
END FUNCTION;

^ Extract the function name from a DEFINE statement
DEFINE function extractFuncName WITH the variable line;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable name BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            CALL trim WITH the value of word;
            LET the variable trimmedWord BE the RESPONSE;
            IF the length of trimmedWord IS greater than the number 0 THEN
                SET the variable name TO the value of trimmedWord;
                SET the variable found TO the number 2;
            END IF;
        END IF;
        
        IF the value of word IS equal to the string "function" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of name;
END FUNCTION;

^ Extract the function parameters from a DEFINE statement
DEFINE function extractFuncParams WITH the variable line;
    LET the variable params BE [];
    
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable paramStr BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            IF the length of paramStr IS greater than the number 0 THEN
                SET the variable paramStr TO the value of paramStr plus the string " ";
            END IF;
            SET the variable paramStr TO the value of paramStr plus the value of word;
        END IF;
        
        IF the value of word IS equal to the string "variables" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    IF the length of paramStr IS greater than the number 0 THEN
        CALL split WITH the value of paramStr, the string ",";
        LET the variable paramList BE the RESPONSE;
        LET the variable pCount BE the size of paramList;
        LET the variable pIdx BE the number 0;
        
        WHILST the value of pIdx IS less than the value of pCount DO
            CALL getItem WITH the value of pIdx, the value of paramList;
            LET the variable param BE the RESPONSE;
            CALL trim WITH the value of param;
            LET the variable trimmedParam BE the RESPONSE;
            IF the length of trimmedParam IS greater than the number 0 THEN
                SET the variable params TO the append of the value of trimmedParam to params;
            END IF;
            SET the variable pIdx TO the value of pIdx plus the number 1;
        END WHILST;
    END IF;
    
    RETURN the value of params;
END FUNCTION;

^ Extract the CALL function name
DEFINE function extractCallName WITH the variable line;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable name BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            CALL trim WITH the value of word;
            LET the variable trimmedWord BE the RESPONSE;
            IF the length of trimmedWord IS greater than the number 0 THEN
                SET the variable name TO the value of trimmedWord;
                SET the variable found TO the number 2;
            END IF;
        END IF;
        
        IF the value of word IS equal to the string "CALL" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of name;
END FUNCTION;

^ Extract the IMPORT path
DEFINE function extractImportPath WITH the variable line;
    LET the variable path BE the string "";
    
    CALL split WITH the value of line, the string " ";
    LET the variable parts BE the RESPONSE;
    LET the variable partCount BE the size of parts;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    
    WHILST the value of idx IS less than the value of partCount DO
        CALL getItem WITH the value of idx, the value of parts;
        LET the variable part BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            SET the variable path TO the value of part;
            BREAK;
        END IF;
        
        IF the value of part IS equal to the string "file" THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    CALL trim WITH the value of path;
    LET the variable trimmedPath BE the RESPONSE;
    SET the variable path TO the value of trimmedPath;
    
    RETURN the value of path;
END FUNCTION;

^ Extract the PROCLAIM expression (everything after PROCLAIM)
DEFINE function extractProclaimExpr WITH the variable line;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 1;
    LET the variable expr BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the length of expr IS greater than the number 0 THEN
            SET the variable expr TO the value of expr plus the string " ";
        END IF;
        SET the variable expr TO the value of expr plus the value of word;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    CALL trim WITH the value of expr;
    LET the variable trimmedExpr BE the RESPONSE;
    RETURN the value of trimmedExpr;
END FUNCTION;


^ Extract everything after a keyword (e.g., after "BE", "TO", "RETURN")
DEFINE function extractAfterKeyword WITH the variable line, the variable keyword;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 0;
    LET the variable found BE the number 0;
    LET the variable result BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of found IS equal to the number 1 THEN
            IF the length of result IS greater than the number 0 THEN
                SET the variable result TO the value of result plus the string " ";
            END IF;
            SET the variable result TO the value of result plus the value of word;
        END IF;
        
        IF the value of word IS equal to the value of keyword THEN
            SET the variable found TO the number 1;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    CALL trim WITH the value of result;
    LET the variable trimmedResult BE the RESPONSE;
    RETURN the value of trimmedResult;
END FUNCTION;

^ Extract condition (everything between start keyword and end keyword)
DEFINE function extractCondition WITH the variable line, the variable endKeyword;
    CALL split WITH the value of line, the string " ";
    LET the variable words BE the RESPONSE;
    LET the variable wordCount BE the size of words;
    LET the variable idx BE the number 1;
    LET the variable condition BE the string "";
    
    WHILST the value of idx IS less than the value of wordCount DO
        CALL getItem WITH the value of idx, the value of words;
        LET the variable word BE the RESPONSE;
        
        IF the value of word IS equal to the value of endKeyword THEN
            BREAK;
        END IF;
        
        IF the length of condition IS greater than the number 0 THEN
            SET the variable condition TO the value of condition plus the string " ";
        END IF;
        SET the variable condition TO the value of condition plus the value of word;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of condition;
END FUNCTION;

^ ====== Recursive Parse Statement Function ======
^ This function parses the current line (at g_pos) and returns an AST node.
^ It advances g_pos past the statement.
^ For block statements, it recursively calls itself to parse body lines.

DEFINE function parseStatement WITH the variable dummy;
    LET the variable node BE {};
    LET the variable consumed BE the number 0;
    
    ^ Skip empty lines and comments
    CALL getItem WITH the value of g_pos, the value of g_lines;
    LET the variable line BE the RESPONSE;
    CALL trim WITH the value of line;
    LET the variable trimmed BE the RESPONSE;
    
    IF the value of trimmed IS equal to the string "" THEN
        GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
        CALL createNode WITH "Empty";
        LET the variable emptyNode BE the RESPONSE;
        GLOBAL SET the variable g_result TO the value of emptyNode;
        RETURN the value of emptyNode;
    END IF;
    
    CALL startsWith WITH the value of trimmed, the string "^";
    LET the variable isComment BE the RESPONSE;
    IF the value of isComment IS equal to the number 1 THEN
        GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
        CALL createNode WITH "Comment";
        LET the variable commentNode BE the RESPONSE;
        SET the key "text" IN the map commentNode TO the value of trimmed;
        GLOBAL SET the variable g_result TO the value of commentNode;
        RETURN the value of commentNode;
    END IF;
    
    ^ --- LET statement ---
    CALL startsWith WITH the value of trimmed, the string "LET";
    LET the variable isLet BE the RESPONSE;
    IF the value of isLet IS equal to the number 1 THEN
        CALL createNode WITH "Let";
        LET the variable letNode BE the RESPONSE;
        CALL extractLetName WITH the value of trimmed;
        LET the variable varName BE the RESPONSE;
        SET the key "name" IN the map letNode TO the value of varName;
        
        CALL extractAfterKeyword WITH the value of trimmed, the string "BE";
        LET the variable valueExpr BE the RESPONSE;
        SET the key "value" IN the map letNode TO the value of valueExpr;
        
        SET the variable node TO the value of letNode;
        SET the variable consumed TO the number 1;
    END IF;
    
    ^ --- SET statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "SET";
        LET the variable isSet BE the RESPONSE;
        IF the value of isSet IS equal to the number 1 THEN
            CALL createNode WITH "Set";
            LET the variable setNode BE the RESPONSE;
            CALL extractSetName WITH the value of trimmed;
            LET the variable varName BE the RESPONSE;
            SET the key "name" IN the map setNode TO the value of varName;
            
            CALL extractAfterKeyword WITH the value of trimmed, the string "TO";
            LET the variable valueExpr BE the RESPONSE;
            SET the key "value" IN the map setNode TO the value of valueExpr;
            
            SET the variable node TO the value of setNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- PROCLAIM statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "PROCLAIM";
        LET the variable isProclaim BE the RESPONSE;
        IF the value of isProclaim IS equal to the number 1 THEN
            CALL createNode WITH "Proclaim";
            LET the variable proclaimNode BE the RESPONSE;
            CALL extractProclaimExpr WITH the value of trimmed;
            LET the variable expr BE the RESPONSE;
            SET the key "value" IN the map proclaimNode TO the value of expr;
            SET the variable node TO the value of proclaimNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- IF statement (recursive body parsing) ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "IF";
        LET the variable isIf BE the RESPONSE;
        IF the value of isIf IS equal to the number 1 THEN
            CALL createNode WITH "If";
            LET the variable ifNode BE the RESPONSE;
            
            CALL extractCondition WITH the value of trimmed, the string "THEN";
            LET the variable condition BE the RESPONSE;
            SET the key "condition" IN the map ifNode TO the value of condition;
            
            ^ Collect body by recursively parsing until END IF or ELSE
            LET the variable body BE [];
            GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
            WHILST the value of g_pos IS less than the value of g_lineCount DO
                CALL getItem WITH the value of g_pos, the value of g_lines;
                LET the variable bodyLine BE the RESPONSE;
                CALL trim WITH the value of bodyLine;
                LET the variable trimmedBody BE the RESPONSE;
                
                CALL startsWith WITH the value of trimmedBody, the string "END IF";
                LET the variable isEndIf BE the RESPONSE;
                IF the value of isEndIf IS equal to the number 1 THEN
                    GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    BREAK;
                END IF;
                
                IF the value of trimmedBody IS equal to the string "ELSE" THEN
                    GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    BREAK;
                END IF;
                
                ^ Recursively parse this body line
                CALL parseStatement WITH the number 0;
                LET the variable childNode BE the value of g_result;
                CALL mapGet WITH "type", the value of childNode;
                LET the variable childType BE the RESPONSE;
                
                ^ Only add non-empty, non-comment nodes
                IF the value of childType IS not equal to the string "Empty" THEN
                    IF the value of childType IS not equal to the string "Comment" THEN
                        SET the variable body TO the append of the value of childNode to body;
                    END IF;
                END IF;
            END WHILST;
            
            SET the key "body" IN the map ifNode TO the value of body;
            SET the variable node TO the value of ifNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- WHILST statement (recursive body parsing) ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "WHILST";
        LET the variable isWhile BE the RESPONSE;
        IF the value of isWhile IS equal to the number 1 THEN
            CALL createNode WITH "While";
            LET the variable whileNode BE the RESPONSE;
            
            CALL extractCondition WITH the value of trimmed, the string "DO";
            LET the variable condition BE the RESPONSE;
            SET the key "condition" IN the map whileNode TO the value of condition;
            
            LET the variable body BE [];
            GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
            WHILST the value of g_pos IS less than the value of g_lineCount DO
                CALL getItem WITH the value of g_pos, the value of g_lines;
                LET the variable bodyLine BE the RESPONSE;
                CALL trim WITH the value of bodyLine;
                LET the variable trimmedBody BE the RESPONSE;
                
                CALL startsWith WITH the value of trimmedBody, the string "END WHILST";
                LET the variable isEndWhile BE the RESPONSE;
                IF the value of isEndWhile IS equal to the number 1 THEN
                    GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    BREAK;
                END IF;
                
                ^ Recursively parse this body line
                CALL parseStatement WITH the number 0;
                LET the variable childNode BE the value of g_result;
                CALL mapGet WITH "type", the value of childNode;
                LET the variable childType BE the RESPONSE;
                
                IF the value of childType IS not equal to the string "Empty" THEN
                    IF the value of childType IS not equal to the string "Comment" THEN
                        SET the variable body TO the append of the value of childNode to body;
                    END IF;
                END IF;
            END WHILST;
            
            SET the key "body" IN the map whileNode TO the value of body;
            SET the variable node TO the value of whileNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- DEFINE function (recursive body parsing) ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "DEFINE";
        LET the variable isDefine BE the RESPONSE;
        IF the value of isDefine IS equal to the number 1 THEN
            CALL createNode WITH "FunctionDef";
            LET the variable funcNode BE the RESPONSE;
            
            CALL extractFuncName WITH the value of trimmed;
            LET the variable funcName BE the RESPONSE;
            SET the key "name" IN the map funcNode TO the value of funcName;
            
            CALL extractFuncParams WITH the value of trimmed;
            LET the variable params BE the RESPONSE;
            SET the key "params" IN the map funcNode TO the value of params;
            
            LET the variable body BE [];
            GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
            WHILST the value of g_pos IS less than the value of g_lineCount DO
                CALL getItem WITH the value of g_pos, the value of g_lines;
                LET the variable bodyLine BE the RESPONSE;
                CALL trim WITH the value of bodyLine;
                LET the variable trimmedBody BE the RESPONSE;
                
                CALL startsWith WITH the value of trimmedBody, the string "END FUNCTION";
                LET the variable isEndFunc BE the RESPONSE;
                IF the value of isEndFunc IS equal to the number 1 THEN
                    GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    BREAK;
                END IF;
                
                ^ Recursively parse this body line
                CALL parseStatement WITH the number 0;
                LET the variable childNode BE the value of g_result;
                CALL mapGet WITH "type", the value of childNode;
                LET the variable childType BE the RESPONSE;
                
                IF the value of childType IS not equal to the string "Empty" THEN
                    IF the value of childType IS not equal to the string "Comment" THEN
                        SET the variable body TO the append of the value of childNode to body;
                    END IF;
                END IF;
            END WHILST;
            
            SET the key "body" IN the map funcNode TO the value of body;
            SET the variable node TO the value of funcNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- FOR statement (recursive body parsing) ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "FOR";
        LET the variable isFor BE the RESPONSE;
        IF the value of isFor IS equal to the number 1 THEN
            CALL createNode WITH "ForIn";
            LET the variable forNode BE the RESPONSE;
            
            SET the key "header" IN the map forNode TO the value of trimmed;
            
            LET the variable body BE [];
            GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
            WHILST the value of g_pos IS less than the value of g_lineCount DO
                CALL getItem WITH the value of g_pos, the value of g_lines;
                LET the variable bodyLine BE the RESPONSE;
                CALL trim WITH the value of bodyLine;
                LET the variable trimmedBody BE the RESPONSE;
                
                CALL startsWith WITH the value of trimmedBody, the string "END FOR";
                LET the variable isEndFor BE the RESPONSE;
                IF the value of isEndFor IS equal to the number 1 THEN
                    GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    BREAK;
                END IF;
                
                ^ Recursively parse this body line
                CALL parseStatement WITH the number 0;
                LET the variable childNode BE the value of g_result;
                CALL mapGet WITH "type", the value of childNode;
                LET the variable childType BE the RESPONSE;
                
                IF the value of childType IS not equal to the string "Empty" THEN
                    IF the value of childType IS not equal to the string "Comment" THEN
                        SET the variable body TO the append of the value of childNode to body;
                    END IF;
                END IF;
            END WHILST;
            
            SET the key "body" IN the map forNode TO the value of body;
            SET the variable node TO the value of forNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- CALL statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "CALL";
        LET the variable isCall BE the RESPONSE;
        IF the value of isCall IS equal to the number 1 THEN
            CALL createNode WITH "Call";
            LET the variable callNode BE the RESPONSE;
            CALL extractCallName WITH the value of trimmed;
            LET the variable callName BE the RESPONSE;
            SET the key "name" IN the map callNode TO the value of callName;
            SET the variable node TO the value of callNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- IMPORT statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "IMPORT";
        LET the variable isImport BE the RESPONSE;
        IF the value of isImport IS equal to the number 1 THEN
            CALL createNode WITH "Import";
            LET the variable importNode BE the RESPONSE;
            CALL extractImportPath WITH the value of trimmed;
            LET the variable importPath BE the RESPONSE;
            SET the key "path" IN the map importNode TO the value of importPath;
            SET the variable node TO the value of importNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- RETURN statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "RETURN";
        LET the variable isReturn BE the RESPONSE;
        IF the value of isReturn IS equal to the number 1 THEN
            CALL createNode WITH "Return";
            LET the variable returnNode BE the RESPONSE;
            CALL extractAfterKeyword WITH the value of trimmed, the string "RETURN";
            LET the variable returnExpr BE the RESPONSE;
            SET the key "value" IN the map returnNode TO the value of returnExpr;
            SET the variable node TO the value of returnNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- FILE WRITE statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "IN the file";
        LET the variable isFileWrite BE the RESPONSE;
        IF the value of isFileWrite IS equal to the number 1 THEN
            CALL createNode WITH "FileWrite";
            LET the variable fileWriteNode BE the RESPONSE;
            SET the key "value" IN the map fileWriteNode TO the value of trimmed;
            SET the variable node TO the value of fileWriteNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- BREAK statement ---
    IF the value of consumed IS equal to the number 0 THEN
        IF the value of trimmed IS equal to the string "BREAK" THEN
            CALL createNode WITH "Break";
            LET the variable breakNode BE the RESPONSE;
            SET the variable node TO the value of breakNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- CONTINUE statement ---
    IF the value of consumed IS equal to the number 0 THEN
        IF the value of trimmed IS equal to the string "CONTINUE" THEN
            CALL createNode WITH "Continue";
            LET the variable continueNode BE the RESPONSE;
            SET the variable node TO the value of continueNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- TERMINATE statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL startsWith WITH the value of trimmed, the string "TERMINATE";
        LET the variable isTerminate BE the RESPONSE;
        IF the value of isTerminate IS equal to the number 1 THEN
            CALL createNode WITH "Terminate";
            LET the variable terminateNode BE the RESPONSE;
            SET the variable node TO the value of terminateNode;
            SET the variable consumed TO the number 1;
        END IF;
    END IF;
    
    ^ --- Unknown statement ---
    IF the value of consumed IS equal to the number 0 THEN
        CALL createNode WITH "Unknown";
        LET the variable unknownNode BE the RESPONSE;
        SET the key "text" IN the map unknownNode TO the value of trimmed;
        SET the variable node TO the value of unknownNode;
    END IF;
    
    ^ Get node type for advance check
    CALL mapGet WITH "type", the value of node;
    LET the variable nodeType BE the RESPONSE;
    
    ^ Advance position only for non-block statements
    IF the value of consumed IS not equal to the number 0 THEN
        IF the value of nodeType IS not equal to the string "While" THEN
            IF the value of nodeType IS not equal to the string "If" THEN
                IF the value of nodeType IS not equal to the string "FunctionDef" THEN
                    IF the value of nodeType IS not equal to the string "ForIn" THEN
                        GLOBAL SET the variable g_pos TO the value of g_pos plus the number 1;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;
    
    ^ Store result in global variable to avoid RESPONSE conflicts during recursion
    GLOBAL SET the variable g_result TO the value of node;
    
    RETURN the value of node;
END FUNCTION;

^ ====== Print AST Function ======
^ Recursively prints an AST node with indentation
DEFINE function printNode WITH the variable node, the variable indent;
    CALL mapGet WITH "type", the value of node;
    LET the variable nodeType BE the RESPONSE;
    
    PROCLAIM the value of indent;
    PROCLAIM the string "Node: ";
    PROCLAIM the value of nodeType;
    PROCLAIM the string "";
    
    ^ Print name if present
    CALL mapGet WITH "name", the value of node;
    LET the variable nodeName BE the RESPONSE;
    IF the length of nodeName IS greater than the number 0 THEN
        PROCLAIM the value of indent;
        PROCLAIM the string "  Name: ";
        PROCLAIM the value of nodeName;
        PROCLAIM the string "";
    END IF;
    
    ^ Print value if present
    CALL mapGet WITH "value", the value of node;
    LET the variable nodeValue BE the RESPONSE;
    IF the length of nodeValue IS greater than the number 0 THEN
        PROCLAIM the value of indent;
        PROCLAIM the string "  Value: ";
        PROCLAIM the value of nodeValue;
        PROCLAIM the string "";
    END IF;
    
    ^ Print condition if present (for IF and WHILE nodes)
    CALL mapGet WITH "condition", the value of node;
    LET the variable nodeCondition BE the RESPONSE;
    IF the length of nodeCondition IS greater than the number 0 THEN
        PROCLAIM the value of indent;
        PROCLAIM the string "  Condition: ";
        PROCLAIM the value of nodeCondition;
        PROCLAIM the string "";
    END IF;
    
    ^ Print params if present (for function nodes)
    CALL mapGet WITH "params", the value of node;
    LET the variable nodeParams BE the RESPONSE;
    IF the value of nodeParams IS not equal to the string "" THEN
        PROCLAIM the value of indent;
        PROCLAIM the string "  Params: ";
        PROCLAIM the value of nodeParams;
        PROCLAIM the string "";
    END IF;
    
    ^ Print path if present (for import nodes)
    CALL mapGet WITH "path", the value of node;
    LET the variable nodePath BE the RESPONSE;
    IF the length of nodePath IS greater than the number 0 THEN
        PROCLAIM the value of indent;
        PROCLAIM the string "  Path: ";
        PROCLAIM the value of nodePath;
        PROCLAIM the string "";
    END IF;
    
    ^ Print body
    CALL mapGet WITH "body", the value of node;
    LET the variable body BE the RESPONSE;
    ^ Check if body is a non-empty string (meaning it might be a list representation)
    IF the value of body IS not equal to the string "" THEN
        LET the variable bodySize BE the size of body;
        IF the value of bodySize IS greater than the number 0 THEN
            PROCLAIM the value of indent;
            PROCLAIM the string "  Body (";
            PROCLAIM the number bodySize;
            PROCLAIM the string " children):";
            PROCLAIM the string "";
            
            LET the variable bIdx BE the number 0;
            WHILST the value of bIdx IS less than the value of bodySize DO
                CALL getItem WITH the value of bIdx, the value of body;
                LET the variable child BE the RESPONSE;
                CALL printNode WITH the value of child, the value of indent plus the string "    ";
                SET the variable bIdx TO the value of bIdx plus the number 1;
            END WHILST;
        END IF;
    END IF;
END FUNCTION;

^ ====== Main Parser ======

LET the variable filePath BE "examples/hello.mish";
PROCLAIM the string "Parsing: ";
PROCLAIM the value of filePath;
PROCLAIM the string "";

LET the variable source BE the content of the file the value of filePath;
CALL split WITH the value of source, the string "\n";
LET the variable sourceLines BE the RESPONSE;

^ Initialize global state
SET the variable g_lines TO the value of sourceLines;
SET the variable g_pos TO the number 0;
SET the variable g_lineCount TO the size of g_lines;
SET the variable g_ast TO [];

^ Parse all top-level statements
WHILST the value of g_pos IS less than the value of g_lineCount DO
    CALL parseStatement WITH the number 0;
    LET the variable node BE the value of g_result;
    
    CALL mapGet WITH "type", the value of node;
    LET the variable nodeType BE the RESPONSE;
    
    ^ Only add non-empty, non-comment nodes to the AST
    IF the value of nodeType IS not equal to the string "Empty" THEN
        IF the value of nodeType IS not equal to the string "Comment" THEN
            GLOBAL SET the variable g_ast TO the append of the value of node to g_ast;
        END IF;
    END IF;
END WHILST;

^ ====== Print the AST ======

PROCLAIM the string "--- AST ---";

LET the variable astSize BE the size of g_ast;
LET the variable idx BE the number 0;
WHILST the value of idx IS less than the value of astSize DO
    CALL getItem WITH the value of idx, the value of g_ast;
    LET the variable node BE the RESPONSE;
    
    CALL printNode WITH the value of node, the string "";
    PROCLAIM the string "";
    
    SET the variable idx TO the value of idx plus the number 1;
END WHILST;

PROCLAIM the string "";
PROCLAIM the string "AST building complete!";
PROCLAIM the string "Total nodes: ";
PROCLAIM the number astSize;
