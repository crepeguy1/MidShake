^ semantic.mish
^ A semantic analyzer written in MidShake.
^ It performs type checking, variable declaration validation, and function call validation.
^ Uses GLOBAL SET to share state across recursive function calls.

IMPORT the file "stdlib/stdlib.mish";

^ ====== Global State ======
^ Symbol table stored as a map: name -> type
LET the variable g_symbols BE {};
^ Function definitions stored as a map: name -> param_count
LET the variable g_functions BE {};
^ Error list
LET the variable g_errors BE [];
^ Scope stack (list of maps)
LET the variable g_scopeStack BE [];
^ Current scope depth
LET the variable g_scopeDepth BE the number 0;

^ Built-in variables
LET the variable g_builtins BE ["RESPONSE", "the RESPONSE", "the answer"];

^ ====== Helper: Add an error ======
DEFINE function addError WITH the variable message;
    CALL append WITH the value of message, the value of g_errors;
    LET the variable newErrors BE the RESPONSE;
    GLOBAL SET the variable g_errors TO the value of newErrors;
    RETURN the value of g_errors;
END FUNCTION;

^ ====== Helper: Lookup a symbol ======
DEFINE function lookupSymbol WITH the variable name;
    CALL mapGet WITH the value of name, the value of g_symbols;
    LET the variable result BE the RESPONSE;
    RETURN the value of result;
END FUNCTION;

^ ====== Helper: Declare a symbol ======
DEFINE function declareSymbol WITH the variable name, the variable symbolType;
    CALL mapGet WITH the value of name, the value of g_symbols;
    LET the variable existing BE the RESPONSE;
    IF the value of existing IS not equal to the string "" THEN
        RETURN the number 0;
    END IF;
    SET the key the value of name IN the map g_symbols TO the value of symbolType;
    GLOBAL SET the variable g_symbols TO the value of g_symbols;
    RETURN the number 1;
END FUNCTION;

^ ====== Helper: Infer type from expression string ======
DEFINE function inferType WITH the variable expr;
    CALL trim WITH the value of expr;
    LET the variable trimmed BE the RESPONSE;
    
    ^ String literal
    CALL startsWith WITH the value of trimmed, the string "the string";
    LET the variable isString BE the RESPONSE;
    IF the value of isString IS equal to the number 1 THEN
        RETURN the string "String";
    END IF;
    
    ^ Number literal
    CALL startsWith WITH the value of trimmed, the string "the number";
    LET the variable isNumber BE the RESPONSE;
    IF the value of isNumber IS equal to the number 1 THEN
        RETURN the string "Number";
    END IF;
    
    ^ List literal
    CALL startsWith WITH the value of trimmed, the string "[";
    LET the variable isList BE the RESPONSE;
    IF the value of isList IS equal to the number 1 THEN
        RETURN the string "List";
    END IF;
    
    ^ Map literal
    CALL startsWith WITH the value of trimmed, the string "{";
    LET the variable isMap BE the RESPONSE;
    IF the value of isMap IS equal to the number 1 THEN
        RETURN the string "Map";
    END IF;
    
    ^ Variable reference
    CALL startsWith WITH the value of trimmed, the string "the value of";
    LET the variable isValue BE the RESPONSE;
    IF the value of isValue IS equal to the number 1 THEN
        CALL length WITH the string "the value of";
        LET the variable prefixLen BE the RESPONSE;
        CALL substring WITH the value of trimmed, the value of prefixLen, the length of trimmed;
        LET the variable varName BE the RESPONSE;
        CALL trim WITH the value of varName;
        LET the variable trimmedVar BE the RESPONSE;
        CALL lookupSymbol WITH the value of trimmedVar;
        LET the variable varType BE the RESPONSE;
        IF the value of varType IS not equal to the string "" THEN
            RETURN the value of varType;
        END IF;
        RETURN the string "Any";
    END IF;
    
    ^ Default: Any
    RETURN the string "Any";
END FUNCTION;

^ ====== Analyze a LET statement ======
DEFINE function analyzeLet WITH the variable line;
    CALL extractLetName FROM the value of line;
    LET the variable varName BE the RESPONSE;
    IF the length of varName IS greater than the number 0 THEN
        CALL lookupSymbol WITH the value of varName;
        LET the variable existing BE the RESPONSE;
        IF the value of existing IS not equal to the string "" THEN
            CALL addError WITH "Variable '" + varName + "' is already declared.";
        ELSE
            CALL declareSymbol WITH the value of varName, the string "Any";
        END IF;
    END IF;
    RETURN the number 0;
END FUNCTION;

^ ====== Analyze a SET statement ======
DEFINE function analyzeSet WITH the variable line;
    CALL extractSetName FROM the value of line;
    LET the variable varName BE the RESPONSE;
    IF the length of varName IS greater than the number 0 THEN
        CALL lookupSymbol WITH the value of varName;
        LET the variable existing BE the RESPONSE;
        IF the value of existing IS equal to the string "" THEN
            CALL addError WITH "Variable '" + varName + "' is not declared. Use LET first.";
        END IF;
    END IF;
    RETURN the number 0;
END FUNCTION;

^ ====== Analyze a CALL statement ======
DEFINE function analyzeCall WITH the variable line;
    CALL extractCallName FROM the value of line;
    LET the variable funcName BE the RESPONSE;
    IF the length of funcName IS greater than the number 0 THEN
        CALL mapGet WITH the value of funcName, the value of g_functions;
        LET the variable funcDef BE the RESPONSE;
        IF the value of funcDef IS equal to the string "" THEN
            ^ Check if it's a known stdlib function
            LET the variable isStdlib BE the number 0;
            IF the value of funcName IS equal to the string "trim" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of funcName IS equal to the string "length" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of funcName IS equal to the string "startsWith" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of funcName IS equal to the string "getItem" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of funcName IS equal to the string "mapGet" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of funcName IS equal to the string "charAt" THEN
                SET the variable isStdlib TO the number 1;
            END IF;
            IF the value of isStdlib IS equal to the number 0 THEN
                CALL addError WITH "Function '" + funcName + "' is not defined.";
            END IF;
        END IF;
    END IF;
    RETURN the number 0;
END FUNCTION;

^ ====== Collect function definitions ======
DEFINE function collectFunctions WITH the variable lines;
    LET the variable lineCount BE the size of lines;
    LET the variable idx BE the number 0;
    WHILST the value of idx IS less than the value of lineCount DO
        CALL getItem WITH the value of idx, the value of lines;
        LET the variable line BE the RESPONSE;
        CALL trim WITH the value of line;
        LET the variable trimmed BE the RESPONSE;
        CALL startsWith WITH the value of trimmed, the string "DEFINE";
        LET the variable isDefine BE the RESPONSE;
        IF the value of isDefine IS equal to the number 1 THEN
            CALL extractFuncName FROM the value of trimmed;
            LET the variable funcName BE the RESPONSE;
            IF the length of funcName IS greater than the number 0 THEN
                SET the key the value of funcName IN the map g_functions TO the number 1;
                GLOBAL SET the variable g_functions TO the value of g_functions;
            END IF;
        END IF;
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    RETURN the number 0;
END FUNCTION;

^ ====== Main analyze function ======
DEFINE function analyze WITH the variable lines;
    ^ Reset state
    GLOBAL SET the variable g_symbols TO {};
    GLOBAL SET the variable g_functions TO {};
    GLOBAL SET the variable g_errors TO [];
    
    ^ Register builtins
    LET the variable builtinCount BE the size of g_builtins;
    LET the variable bIdx BE the number 0;
    WHILST the value of bIdx IS less than the value of builtinCount DO
        CALL getItem WITH the value of bIdx, the value of g_builtins;
        LET the variable builtin BE the RESPONSE;
        SET the key the value of builtin IN the map g_symbols TO the string "Any";
        GLOBAL SET the variable g_symbols TO the value of g_symbols;
        SET the variable bIdx TO the value of bIdx plus the number 1;
    END WHILST;
    
    ^ Pass 1: Collect function definitions
    CALL collectFunctions WITH the value of lines;
    
    ^ Pass 2: Analyze all statements
    LET the variable lineCount BE the size of lines;
    LET the variable idx BE the number 0;
    WHILST the value of idx IS less than the value of lineCount DO
        CALL getItem WITH the value of idx, the value of lines;
        LET the variable line BE the RESPONSE;
        CALL trim WITH the value of line;
        LET the variable trimmed BE the RESPONSE;
        
        ^ Skip empty lines and comments
        IF the length of trimmed IS greater than the number 0 THEN
            CALL startsWith WITH the value of trimmed, the string "^";
            LET the variable isComment BE the RESPONSE;
            IF the value of isComment IS equal to the number 0 THEN
                CALL startsWith WITH the value of trimmed, the string "LET";
                LET the variable isLet BE the RESPONSE;
                IF the value of isLet IS equal to the number 1 THEN
                    CALL analyzeLet WITH the value of trimmed;
                END IF;
                
                CALL startsWith WITH the value of trimmed, the string "SET";
                LET the variable isSet BE the RESPONSE;
                IF the value of isSet IS equal to the number 1 THEN
                    CALL analyzeSet WITH the value of trimmed;
                END IF;
                
                CALL startsWith WITH the value of trimmed, the string "CALL";
                LET the variable isCall BE the RESPONSE;
                IF the value of isCall IS equal to the number 1 THEN
                    CALL analyzeCall WITH the value of trimmed;
                END IF;
            END IF;
        END IF;
        
        SET the variable idx TO the value of idx plus the number 1;
    END WHILST;
    
    RETURN the value of g_errors;
END FUNCTION;

^ ====== Print analysis results ======
DEFINE function printResults WITH the variable dummy;
    LET the variable errorCount BE the size of g_errors;
    IF the value of errorCount IS equal to the number 0 THEN
        PROCLAIM the string "No semantic errors found.";
    ELSE
        PROCLAIM the string "Found ";
        PROCLAIM the number errorCount;
        PROCLAIM the string " semantic error(s):";
        LET the variable eIdx BE the number 0;
        WHILST the value of eIdx IS less than the value of errorCount DO
            CALL getItem WITH the value of eIdx, the value of g_errors;
            LET the variable error BE the RESPONSE;
            PROCLAIM the string "  - ";
            PROCLAIM the value of error;
            PROCLAIM the string "";
            SET the variable eIdx TO the value of eIdx plus the number 1;
        END WHILST;
    END IF;
    RETURN the number 0;
END FUNCTION;
