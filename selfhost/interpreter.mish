^ interpreter.mish
^ An AST interpreter written in MidShake.
^ It takes the AST produced by parser.mish and executes it.
^ Uses GLOBAL SET to share state (variables, functions, response) across recursive calls.
^ ALL loop counters use global variables to survive deep-copy scope restoration across CALL boundaries.

IMPORT the file "stdlib/stdlib.mish";
IMPORT the file "selfhost/parser.mish";

^ ====== Global State ======
^ Variables store: a map where keys are variable names and values are their values
LET the variable g_vars BE {};
^ Functions store: a map where keys are function names and values are function AST nodes
LET the variable g_funcs BE {};
^ RESPONSE variable: holds the return value of the last CALL
LET the variable RESPONSE BE the string "";
^ Call stack: tracks whether we are inside a function call for RETURN handling
LET the variable callStack BE [];
^ Return value: holds the return value when RETURN is executed
LET the variable returnValue BE the string "";
^ g_execResult: holds the result of executeNode, shared via GLOBAL SET
LET the variable g_execResult BE the string "";
^ Global loop counters to survive deep-copy scope restoration
LET the variable g_bIdx BE the number 0;
LET the variable g_i BE the number 0;
LET the variable g_idx BE the number 0;
^ Global node reference to survive deep-copy across CALL boundaries
LET the variable g_node BE {};

^ ====== Helper: Replace all occurrences of a substring ======
^ Uses the Python-side replace function for efficiency
DEFINE function replaceAll WITH the variables text, old, new;
    CALL replace WITH the value of text, the value of old, the value of new;
    LET the variable result BE the RESPONSE;
    RETURN the value of result;
END FUNCTION;

^ ====== Helper: Normalize keyword spacing ======
^ Inserts spaces between MidShake keywords that may have been concatenated (e.g., "thestring" -> "the string")
DEFINE function normalizeExpr WITH the variable expr;
    CALL trim WITH the value of expr;
    LET the variable result BE the RESPONSE;
    
    ^ Replace concatenated keywords with spaced versions (order matters: longest first)
    CALL replaceAll WITH the value of result, the string "thevalueof", the string "the value of";
    LET the variable r1 BE the RESPONSE;
    SET the variable result TO the value of r1;
    
    CALL replaceAll WITH the value of result, the string "thelengthof", the string "the length of";
    LET the variable r2 BE the RESPONSE;
    SET the variable result TO the value of r2;
    
    CALL replaceAll WITH the value of result, the string "thesizeof", the string "the size of";
    LET the variable r3 BE the RESPONSE;
    SET the variable result TO the value of r3;
    
    CALL replaceAll WITH the value of result, the string "thenumber", the string "the number";
    LET the variable r4 BE the RESPONSE;
    SET the variable result TO the value of r4;
    
    CALL replaceAll WITH the value of result, the string "thestring", the string "the string";
    LET the variable r5 BE the RESPONSE;
    SET the variable result TO the value of r5;
    
    CALL replaceAll WITH the value of result, the string "theitematposition", the string "the item at position";
    LET the variable r6 BE the RESPONSE;
    SET the variable result TO the value of r6;
    
    CALL trim WITH the value of result;
    LET the variable finalResult BE the RESPONSE;
    RETURN the value of finalResult;
END FUNCTION;

^ ====== Helper: Evaluate an expression string ======
^ Parses expression strings like "the value of X", "the number 5", "the string hello", etc.
DEFINE function evaluateExpr WITH the variable expr;
    CALL trim WITH the value of expr;
    LET the variable trimmed BE the RESPONSE;
    
    ^ Normalize keyword spacing (e.g., "thestring" -> "the string")
    CALL normalizeExpr WITH the value of trimmed;
    LET the variable normalized BE the RESPONSE;
    SET the variable trimmed TO the value of normalized;
    
    ^ Strip trailing semicolons using split approach
    CALL split WITH the value of trimmed, the string ";";
    LET the variable semiParts BE the RESPONSE;
    LET the variable semiCount BE the size of semiParts;
    IF the value of semiCount IS greater than the number 1 THEN
        ^ Rejoin all parts except check if last part is empty (trailing semicolon)
        CALL getItem WITH the value of semiCount minus the number 1, the value of semiParts;
        LET the variable lastPart BE the RESPONSE;
        CALL trim WITH the value of lastPart;
        LET the variable trimmedLast BE the RESPONSE;
        IF the value of trimmedLast IS equal to the string "" THEN
            ^ Last part is empty, meaning trailing semicolon — use all but last part
            SET the variable trimmed TO the string "";
            LET the variable spIdx BE the number 0;
            WHILST the value of spIdx IS less than the value of semiCount minus the number 1 DO
                CALL getItem WITH the value of spIdx, the value of semiParts;
                LET the variable sp BE the RESPONSE;
                IF the value of spIdx IS greater than the number 0 THEN
                    SET the variable trimmed TO the value of trimmed plus the string ";";
                END IF;
                SET the variable trimmed TO the value of trimmed plus the value of sp;
                SET the variable spIdx TO the value of spIdx plus the number 1;
            END WHILST;
            CALL trim WITH the value of trimmed;
            LET the variable trimmed2 BE the RESPONSE;
            SET the variable trimmed TO the value of trimmed2;
        END IF;
    END IF;
    
    ^ Handle "the value of VARIABLE"
    CALL startsWith WITH the value of trimmed, the string "the value of";
    LET the variable isValueOf BE the RESPONSE;
    IF the value of isValueOf IS equal to the number 1 THEN
        CALL extractAfterKeyword WITH the value of trimmed, the string "of";
        LET the variable varName BE the RESPONSE;
        CALL trim WITH the variable varName;
        LET the variable trimmedName BE the RESPONSE;
        
        ^ Look up variable in global vars
        CALL mapGet WITH the value of trimmedName, the value of g_vars;
        LET the variable varVal BE the RESPONSE;
        RETURN the value of varVal;
    END IF;
    
    ^ Handle "the number N"
    CALL startsWith WITH the value of trimmed, the string "the number";
    LET the variable isNumber BE the RESPONSE;
    IF the value of isNumber IS equal to the number 1 THEN
        CALL extractAfterKeyword WITH the value of trimmed, the string "number";
        LET the variable numStr BE the RESPONSE;
        CALL trim WITH the value of numStr;
        LET the variable trimmedNum BE the RESPONSE;
        RETURN the value of trimmedNum;
    END IF;
    
    ^ Handle "the string S" (quoted strings) — use split instead of startsWith
    CALL split WITH the value of trimmed, the string "the string";
    LET the variable stringParts BE the RESPONSE;
    LET the variable stringPartCount BE the size of stringParts;
    IF the value of stringPartCount IS greater than the number 1 THEN
        CALL getItem WITH the number 1, the value of stringParts;
        LET the variable strVal BE the RESPONSE;
        CALL trim WITH the value of strVal;
        LET the variable trimmedStr BE the RESPONSE;
        ^ Strip surrounding quotes: remove first and last char if they match
        CALL length WITH the value of trimmedStr;
        LET the variable strLen BE the RESPONSE;
        IF the value of strLen IS greater than or equal to the number 2 THEN
            CALL charAt WITH the value of trimmedStr, the number 0;
            LET the variable firstChar BE the RESPONSE;
            CALL charAt WITH the value of trimmedStr, the value of strLen minus the number 1;
            LET the variable lastChar BE the RESPONSE;
            IF the value of firstChar IS equal to the value of lastChar THEN
                CALL substring WITH the value of trimmedStr, the number 1, the value of strLen minus the number 1;
                LET the variable unquoted BE the RESPONSE;
                SET the variable trimmedStr TO the value of unquoted;
            END IF;
        END IF;
        RETURN the value of trimmedStr;
    END IF;
    
    ^ Handle arithmetic: "X plus Y", "X minus Y", "X times Y", "X divided by Y"
    CALL split WITH the value of trimmed, the string " plus ";
    LET the variable plusParts BE the RESPONSE;
    LET the variable plusCount BE the size of plusParts;
    IF the value of plusCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of plusParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of plusParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        RETURN the value of left plus the value of right;
    END IF;
    
    CALL split WITH the value of trimmed, the string " minus ";
    LET the variable minusParts BE the RESPONSE;
    LET the variable minusCount BE the size of minusParts;
    IF the value of minusCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of minusParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of minusParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        RETURN the value of left minus the value of right;
    END IF;
    
    CALL split WITH the value of trimmed, the string " times ";
    LET the variable timesParts BE the RESPONSE;
    LET the variable timesCount BE the size of timesParts;
    IF the value of timesCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of timesParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of timesParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        RETURN the value of left times the value of right;
    END IF;
    
    CALL split WITH the value of trimmed, the string " divided by ";
    LET the variable divParts BE the RESPONSE;
    LET the variable divCount BE the size of divParts;
    IF the value of divCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of divParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of divParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        RETURN the value of left divided by the value of right;
    END IF;
    
    ^ Handle "the size of X"
    CALL startsWith WITH the value of trimmed, the string "the size of";
    LET the variable isSizeOf BE the RESPONSE;
    IF the value of isSizeOf IS equal to the number 1 THEN
        CALL extractAfterKeyword WITH the value of trimmed, the string "of";
        LET the variable varName BE the RESPONSE;
        CALL trim WITH the value of varName;
        LET the variable trimmedName BE the RESPONSE;
        CALL mapGet WITH the value of trimmedName, the value of g_vars;
        LET the variable varVal BE the RESPONSE;
        CALL length WITH the value of varVal;
        LET the variable sizeVal BE the RESPONSE;
        RETURN the value of sizeVal;
    END IF;
    
    ^ Handle "the length of X"
    CALL startsWith WITH the value of trimmed, the string "the length of";
    LET the variable isLengthOf BE the RESPONSE;
    IF the value of isLengthOf IS equal to the number 1 THEN
        CALL extractAfterKeyword WITH the value of trimmed, the string "of";
        LET the variable varName BE the RESPONSE;
        CALL trim WITH the value of varName;
        LET the variable trimmedName BE the RESPONSE;
        CALL mapGet WITH the value of trimmedName, the value of g_vars;
        LET the variable varVal BE the RESPONSE;
        CALL length WITH the value of varVal;
        LET the variable lengthVal BE the RESPONSE;
        RETURN the value of lengthVal;
    END IF;
    
    ^ Handle bare variable names (no prefix)
    CALL mapGet WITH the value of trimmed, the value of g_vars;
    LET the variable bareVal BE the RESPONSE;
    IF the value of bareVal IS not equal to the string "" THEN
        RETURN the value of bareVal;
    END IF;
    
    ^ Return the expression as-is (literal)
    RETURN the value of trimmed;
END FUNCTION;

^ ====== Helper: Evaluate a condition ======
^ Parses condition strings like "the value of X IS equal to the number 1"
DEFINE function evaluateCondition WITH the variable condition;
    CALL trim WITH the value of condition;
    LET the variable trimmed BE the RESPONSE;
    
    ^ Normalize keyword spacing
    CALL normalizeExpr WITH the value of trimmed;
    LET the variable normalizedCond BE the RESPONSE;
    SET the variable trimmed TO the value of normalizedCond;
    
    ^ Handle "X IS equal to Y"
    CALL split WITH the value of trimmed, the string " IS equal to ";
    LET the variable eqParts BE the RESPONSE;
    LET the variable eqCount BE the size of eqParts;
    IF the value of eqCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of eqParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of eqParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS equal to the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Handle "X IS not equal to Y"
    CALL split WITH the value of trimmed, the string " IS not equal to ";
    LET the variable neParts BE the RESPONSE;
    LET the variable neCount BE the size of neParts;
    IF the value of neCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of neParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of neParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS not equal to the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Handle "X IS less than Y"
    CALL split WITH the value of trimmed, the string " IS less than ";
    LET the variable ltParts BE the RESPONSE;
    LET the variable ltCount BE the size of ltParts;
    IF the value of ltCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of ltParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of ltParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS less than the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Handle "X IS greater than Y"
    CALL split WITH the value of trimmed, the string " IS greater than ";
    LET the variable gtParts BE the RESPONSE;
    LET the variable gtCount BE the size of gtParts;
    IF the value of gtCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of gtParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of gtParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS greater than the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Handle "X IS less than or equal to Y"
    CALL split WITH the value of trimmed, the string " IS less than or equal to ";
    LET the variable lteParts BE the RESPONSE;
    LET the variable lteCount BE the size of lteParts;
    IF the value of lteCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of lteParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of lteParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS less than or equal to the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Handle "X IS greater than or equal to Y"
    CALL split WITH the value of trimmed, the string " IS greater than or equal to ";
    LET the variable gteParts BE the RESPONSE;
    LET the variable gteCount BE the size of gteParts;
    IF the value of gteCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of gteParts;
        LET the variable leftExpr BE the RESPONSE;
        CALL getItem WITH the number 1, the value of gteParts;
        LET the variable rightExpr BE the RESPONSE;
        CALL evaluateExpr WITH the value of leftExpr;
        LET the variable left BE the RESPONSE;
        CALL evaluateExpr WITH the value of rightExpr;
        LET the variable right BE the RESPONSE;
        IF the value of left IS greater than or equal to the value of right THEN
            RETURN the number 1;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ Default: treat truthy values as true
    CALL evaluateExpr WITH the value of trimmed;
    LET the variable result BE the RESPONSE;
    IF the value of result IS equal to the number 1 THEN
        RETURN the number 1;
    END IF;
    IF the value of result IS equal to the string "true" THEN
        RETURN the number 1;
    END IF;
    RETURN the number 0;
END FUNCTION;

^ ====== Execute a single AST node ======
^ This is the core interpreter function — it dispatches based on node type.
^ Uses global loop counters (g_bIdx) to survive deep-copy scope restoration.
^ Saves node to g_node before any CALL that would reset local scope.
^ Uses inline map access instead of mapGet to avoid deep-copy key loss.
DEFINE function executeNode WITH the variable node;
    GLOBAL SET the variable g_node TO the value of node;
    
    ^ Read node type directly from g_node using inline map access
    LET the variable nodeType BE the value of type in g_node;
    
    ^ Trim node type to handle any whitespace
    CALL trim WITH the value of nodeType;
    LET the variable trimmedType BE the RESPONSE;
    SET the variable nodeType TO the value of trimmedType;
    
    ^ --- Let statement ---
    IF the value of nodeType IS equal to the string "Let" THEN
        LET the variable varName BE the value of name in g_node;
        LET the variable valueExpr BE the value of value in g_node;
        CALL evaluateExpr WITH the value of valueExpr;
        LET the variable evaluated BE the RESPONSE;
        SET the key the value of varName IN the map g_vars TO the value of evaluated;
        GLOBAL SET the variable g_vars TO the value of g_vars;
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Set statement ---
    IF the value of nodeType IS equal to the string "Set" THEN
        LET the variable varName BE the value of name in g_node;
        LET the variable valueExpr BE the value of value in g_node;
        CALL evaluateExpr WITH the value of valueExpr;
        LET the variable evaluated BE the RESPONSE;
        SET the key the value of varName IN the map g_vars TO the value of evaluated;
        GLOBAL SET the variable g_vars TO the value of g_vars;
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Proclaim statement ---
    IF the value of nodeType IS equal to the string "Proclaim" THEN
        LET the variable valueExpr BE the value of value in g_node;
        CALL evaluateExpr WITH the value of valueExpr;
        LET the variable evaluated BE the RESPONSE;
        PROCLAIM the value of evaluated;
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- If statement ---
    IF the value of nodeType IS equal to the string "If" THEN
        LET the variable condition BE the value of condition in g_node;
        CALL evaluateCondition WITH the value of condition;
        LET the variable condResult BE the RESPONSE;
        
        IF the value of condResult IS equal to the number 1 THEN
            LET the variable body BE the value of body in g_node;
            LET the variable bodySize BE the size of body;
            GLOBAL SET the variable g_bIdx TO the number 0;
            WHILST the value of g_bIdx IS less than the value of bodySize DO
                CALL getItem WITH the value of g_bIdx, the value of body;
                LET the variable child BE the RESPONSE;
                CALL executeNode WITH the value of child;
                GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
            END WHILST;
        END IF;
        
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- While statement ---
    IF the value of nodeType IS equal to the string "While" THEN
        LET the variable condition BE the value of condition in g_node;
        LET the variable body BE the value of body in g_node;
        
        WHILST the value of the number 1 IS equal to the number 1 DO
            CALL evaluateCondition WITH the value of condition;
            LET the variable condResult BE the RESPONSE;
            IF the value of condResult IS not equal to the number 1 THEN
                BREAK;
            END IF;
            
            LET the variable bodySize BE the size of body;
            GLOBAL SET the variable g_bIdx TO the number 0;
            WHILST the value of g_bIdx IS less than the value of bodySize DO
                CALL getItem WITH the value of g_bIdx, the value of body;
                LET the variable child BE the RESPONSE;
                CALL executeNode WITH the value of child;
                GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
            END WHILST;
        END WHILST;
        
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Function definition ---
    IF the value of nodeType IS equal to the string "FunctionDef" THEN
        LET the variable funcName BE the value of name in g_node;
        SET the key the value of funcName IN the map g_funcs TO the value of g_node;
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Call statement ---
    IF the value of nodeType IS equal to the string "Call" THEN
        LET the variable callName BE the value of name in g_node;
        LET the variable callValue BE the value of value in g_node;
        
        ^ Look up the function
        CALL mapGet WITH the value of callName, the value of g_funcs;
        LET the variable funcNode BE the RESPONSE;
        
        IF the value of funcNode IS not equal to the string "" THEN
            ^ Push call frame
            SET the variable callStack TO the append of the value of callName to callStack;
            
            ^ Get function params and body
            CALL mapGet WITH "params", the value of funcNode;
            LET the variable params BE the RESPONSE;
            CALL mapGet WITH "body", the value of funcNode;
            LET the variable funcBody BE the RESPONSE;
            
            ^ Parse arguments from the call value expression
            IF the length of callValue IS greater than the number 0 THEN
                CALL split WITH the value of callValue, the string ",";
                LET the variable argParts BE the RESPONSE;
                LET the variable argCount BE the size of argParts;
                GLOBAL SET the variable g_bIdx TO the number 0;
                LET the variable pIdx BE the number 0;
                
                WHILST the value of g_bIdx IS less than the value of argCount DO
                    CALL getItem WITH the value of g_bIdx, the value of argParts;
                    LET the variable argPart BE the RESPONSE;
                    CALL trim WITH the value of argPart;
                    LET the variable trimmedArg BE the RESPONSE;
                    
                    ^ Extract the variable name from "the value of X"
                    CALL startsWith WITH the value of trimmedArg, the string "the value of";
                    LET the variable isValOf BE the RESPONSE;
                    LET the variable paramName BE the string "";
                    LET the variable argValue BE the string "";
                    
                    IF the value of isValOf IS equal to the number 1 THEN
                        CALL extractAfterKeyword WITH the value of trimmedArg, the string "of";
                        LET the variable varRef BE the RESPONSE;
                        CALL trim WITH the value of varRef;
                        LET the variable trimmedRef BE the RESPONSE;
                        CALL evaluateExpr WITH the value of trimmedRef;
                        LET the variable evalArg BE the RESPONSE;
                        SET the variable argValue TO the value of evalArg;
                    ELSE
                        SET the variable argValue TO the value of trimmedArg;
                    END IF;
                    
                    ^ Get the corresponding param name
                    LET the variable paramSize BE the size of params;
                    IF the value of pIdx IS less than the value of paramSize THEN
                        CALL getItem WITH the value of pIdx, the value of params;
                        LET the variable paramNameVal BE the RESPONSE;
                        CALL trim WITH the value of paramNameVal;
                        LET the variable trimmedParam BE the RESPONSE;
                        SET the key the value of trimmedParam IN the map g_vars TO the value of argValue;
                        GLOBAL SET the variable g_vars TO the value of g_vars;
                        SET the variable pIdx TO the value of pIdx plus the number 1;
                    END IF;
                    
                    GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
                END WHILST;
            END IF;
            
            ^ Execute function body
            LET the variable bodySize BE the size of funcBody;
            GLOBAL SET the variable g_bIdx TO the number 0;
            WHILST the value of g_bIdx IS less than the value of bodySize DO
                CALL getItem WITH the value of g_bIdx, the value of funcBody;
                LET the variable child BE the RESPONSE;
                CALL executeNode WITH the value of child;
                GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
            END WHILST;
            
            ^ Pop call frame
            LET the variable stackSize BE the size of callStack;
            IF the value of stackSize IS greater than the number 0 THEN
                SET the variable callStack TO the substring of the value of callStack starting at the number 0 ending at the value of stackSize minus the number 1;
            END IF;
        END IF;
        
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Return statement ---
    IF the value of nodeType IS equal to the string "Return" THEN
        LET the variable returnExpr BE the value of value in g_node;
        CALL evaluateExpr WITH the value of returnExpr;
        LET the variable evaluated BE the RESPONSE;
        SET the variable returnValue TO the value of evaluated;
        SET the variable RESPONSE TO the value of evaluated;
        GLOBAL SET the variable g_execResult TO the value of evaluated;
        RETURN the value of evaluated;
    END IF;
    
    ^ --- FileWrite statement ---
    IF the value of nodeType IS equal to the string "FileWrite" THEN
        LET the variable fileWriteExpr BE the value of value in g_node;
        ^ Parse "IN the file "output.txt" WRITE the value of text"
        CALL split WITH the value of fileWriteExpr, the string "WRITE";
        LET the variable writeParts BE the RESPONSE;
        LET the variable writeCount BE the size of writeParts;
        IF the value of writeCount IS greater than the number 1 THEN
            CALL getItem WITH the number 1, the value of writeParts;
            LET the variable writeContentExpr BE the RESPONSE;
            CALL trim WITH the value of writeContentExpr;
            LET the variable trimmedContent BE the RESPONSE;
            CALL evaluateExpr WITH the value of trimmedContent;
            LET the variable content BE the RESPONSE;
            
            ^ Extract file path
            CALL getItem WITH the number 0, the value of writeParts;
            LET the variable filePart BE the RESPONSE;
            CALL split WITH the value of filePart, the string "file";
            LET the variable fileSplitParts BE the RESPONSE;
            LET the variable fileSplitCount BE the size of fileSplitParts;
            IF the value of fileSplitCount IS greater than the number 1 THEN
                CALL getItem WITH the value of fileSplitCount minus the number 1, the value of fileSplitParts;
                LET the variable filePathRaw BE the RESPONSE;
                CALL trim WITH the value of filePathRaw;
                LET the variable trimmedPath BE the RESPONSE;
                ^ Remove surrounding quotes from the path
                CALL length WITH the value of trimmedPath;
                LET the variable pathLen BE the RESPONSE;
                IF the value of pathLen IS greater than the number 2 THEN
                    CALL charAt WITH the value of trimmedPath, the number 0;
                    LET the variable firstPathChar BE the RESPONSE;
                    CALL charAt WITH the value of trimmedPath, the value of pathLen minus the number 1;
                    LET the variable lastPathChar BE the RESPONSE;
                    IF the value of firstPathChar IS equal to the value of lastPathChar THEN
                        SET the variable trimmedPath TO the substring of the value of trimmedPath starting at the number 1 ending at the value of pathLen;
                    END IF;
                END IF;
                
                IN the file the value of trimmedPath WRITE the value of content;
            END IF;
        END IF;
        
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Break statement ---
    IF the value of nodeType IS equal to the string "Break" THEN
        GLOBAL SET the variable g_execResult TO the string "BREAK";
        RETURN the string "BREAK";
    END IF;
    
    ^ --- Continue statement ---
    IF the value of nodeType IS equal to the string "Continue" THEN
        GLOBAL SET the variable g_execResult TO the string "CONTINUE";
        RETURN the string "CONTINUE";
    END IF;
    
    ^ --- Terminate statement ---
    IF the value of nodeType IS equal to the string "Terminate" THEN
        GLOBAL SET the variable g_execResult TO the string "TERMINATE";
        RETURN the string "TERMINATE";
    END IF;
    
    ^ --- Import statement ---
    IF the value of nodeType IS equal to the string "Import" THEN
        LET the variable importPath BE the value of path in g_node;
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- ForIn statement ---
    IF the value of nodeType IS equal to the string "ForIn" THEN
        LET the variable header BE the value of header in g_node;
        LET the variable body BE the value of body in g_node;
        
        ^ Parse header: "FOR the variable X IN the value of list DO"
        CALL split WITH the value of header, the string " ";
        LET the variable headerParts BE the RESPONSE;
        LET the variable headerCount BE the size of headerParts;
        GLOBAL SET the variable g_bIdx TO the number 0;
        LET the variable foundVar BE the number 0;
        LET the variable forVarName BE the string "";
        LET the variable forListExpr BE the string "";
        
        WHILST the value of g_bIdx IS less than the value of headerCount DO
            CALL getItem WITH the value of g_bIdx, the value of headerParts;
            LET the variable part BE the RESPONSE;
            
            IF the value of foundVar IS equal to the number 1 THEN
                SET the variable forVarName TO the value of part;
                SET the variable foundVar TO the number 2;
            END IF;
            
            IF the value of part IS equal to the string "variable" THEN
                SET the variable foundVar TO the number 1;
            END IF;
            
            GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
        END WHILST;
        
        ^ Extract the list expression (after "IN")
        LET the variable foundIn BE the number 0;
        GLOBAL SET the variable g_bIdx TO the number 0;
        WHILST the value of g_bIdx IS less than the value of headerCount DO
            CALL getItem WITH the value of g_bIdx, the value of headerParts;
            LET the variable part BE the RESPONSE;
            
            IF the value of foundIn IS equal to the number 1 THEN
                IF the length of forListExpr IS greater than the number 0 THEN
                    SET the variable forListExpr TO the value of forListExpr plus the string " ";
                END IF;
                SET the variable forListExpr TO the value of forListExpr plus the value of part;
            END IF;
            
            IF the value of part IS equal to the string "IN" THEN
                SET the variable foundIn TO the number 1;
            END IF;
            
            GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
        END WHILST;
        
        ^ Evaluate the list expression
        CALL evaluateExpr WITH the value of forListExpr;
        LET the variable forList BE the RESPONSE;
        LET the variable listSize BE the size of forList;
        GLOBAL SET the variable g_i TO the number 0;
        
        WHILST the value of g_i IS less than the value of listSize DO
            CALL getItem WITH the value of g_i, the value of forList;
            LET the variable item BE the RESPONSE;
            SET the key the value of forVarName IN the map g_vars TO the value of item;
            GLOBAL SET the variable g_vars TO the value of g_vars;
            
            LET the variable bodySize BE the size of body;
            GLOBAL SET the variable g_bIdx TO the number 0;
            WHILST the value of g_bIdx IS less than the value of bodySize DO
                CALL getItem WITH the value of g_bIdx, the value of body;
                LET the variable child BE the RESPONSE;
                CALL executeNode WITH the value of child;
                GLOBAL SET the variable g_bIdx TO the value of g_bIdx plus the number 1;
            END WHILST;
            
            GLOBAL SET the variable g_i TO the value of g_i plus the number 1;
        END WHILST;
        
        GLOBAL SET the variable g_execResult TO the number 0;
        RETURN the number 0;
    END IF;
    
    ^ --- Unknown node type ---
    GLOBAL SET the variable g_execResult TO the number 0;
    RETURN the number 0;
END FUNCTION;

^ ====== Main: Parse and Execute ======
^ Load the source file, parse it, then execute the AST

LET the variable filePath BE "examples/hello.mish";
PROCLAIM the string "Interpreting: ";
PROCLAIM the value of filePath;
PROCLAIM the string "";

^ Read and split source
LET the variable source BE the content of the file the value of filePath;
CALL split WITH the value of source, the string "\n";
LET the variable sourceLines BE the RESPONSE;

^ Initialize global state
GLOBAL SET the variable g_vars TO {};
GLOBAL SET the variable g_funcs TO {};
GLOBAL SET the variable callStack TO [];

^ Initialize parser state
SET the variable g_lines TO the value of sourceLines;
SET the variable g_pos TO the number 0;
SET the variable g_lineCount TO the size of g_lines;
SET the variable g_ast TO [];

^ Parse all top-level statements
WHILST the value of g_pos IS less than the value of g_lineCount DO
    CALL parseStatement WITH the number 0;
    LET the variable node BE the value of g_result;
    
    CALL mapGet WITH "type", the value of g_node;
    LET the variable nodeType BE the RESPONSE;
    
    IF the value of nodeType IS not equal to the string "Empty" THEN
        IF the value of nodeType IS not equal to the string "Comment" THEN
            GLOBAL SET the variable g_ast TO the append of the value of node to g_ast;
        END IF;
    END IF;
END WHILST;

^ Execute the AST
PROCLAIM the string "--- Executing ---";

GLOBAL SET the variable g_idx TO the size of g_ast;
LET the variable astSize BE the value of g_idx;
GLOBAL SET the variable g_idx TO the number 0;
WHILST the value of g_idx IS less than the value of astSize DO
    CALL getItem WITH the value of g_idx, the value of g_ast;
    LET the variable node BE the RESPONSE;
    
    CALL executeNode WITH the value of node;
    
    GLOBAL SET the variable g_idx TO the value of g_idx plus the number 1;
END WHILST;

PROCLAIM the string "";
PROCLAIM the string "Interpretation complete!";
