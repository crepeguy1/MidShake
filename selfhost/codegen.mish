^ codegen.mish
^ A C++ code generator written in MidShake.
^ It takes the AST produced by parser.mish and generates C++ source code.
^ IMPORTANT: No double quotes inside MidShake string literals — uses QUOTE variable instead.

IMPORT the file "stdlib/stdlib.mish";
IMPORT the file "selfhost/parser.mish";

^ ====== Global State ======
LET the variable g_output BE [];
LET the variable g_indent BE the number 0;
LET the variable g_idx BE the number 0;
LET the variable g_i BE the number 0;
LET the variable g_bIdx BE the number 0;
LET the variable g_currentClass BE the string "";
LET the variable g_currentModuleId BE the string "module_0";
LET the variable g_node BE {};
LET the variable g_compiled BE the string "";
LET the variable g_functions BE [];
LET the variable g_classes BE [];
LET the variable g_mainStmts BE [];
LET the variable g_myAst BE [];
LET the variable g_importedFiles BE [];
LET the variable g_expandedModuleIds BE [];
LET the variable g_moduleCounter BE the number 0;
LET the variable g_moduleDeclarations BE {};
LET the variable g_privateStorage BE {};
LET the variable g_privateSymbols BE [];
LET the variable g_functionNames BE {};
LET the variable g_standardFunctionNames BE {};
^ Double quote character — extracted from a known string containing one
LET the variable quoteSource BE the string "a\"b";
LET the variable QUOTE BE the character at the number 1 in the value of quoteSource;

^ ====== Helper: Emit a line of C++ code ======
DEFINE function emit WITH the variable line;
    LET the variable padding BE the string "";
    LET the variable padIdx BE the number 0;
    WHILST the value of padIdx IS less than the value of g_indent DO
        SET the variable padding TO the value of padding plus the string "    ";
        SET the variable padIdx TO the value of padIdx plus the number 1;
    END WHILST;
    LET the variable fullLine BE the value of padding plus the value of line;
    CALL append WITH the value of fullLine, the value of g_output;
    LET the variable newOutput BE the RESPONSE;
    GLOBAL SET the variable g_output TO the value of newOutput;
    RETURN the value of g_output;
END FUNCTION;

DEFINE function indent WITH the variable dummy;
    GLOBAL SET the variable g_indent TO the value of g_indent plus the number 1;
    RETURN the number 0;
END FUNCTION;

DEFINE function dedent WITH the variable dummy;
    IF the value of g_indent IS greater than the number 0 THEN
        GLOBAL SET the variable g_indent TO the value of g_indent minus the number 1;
    END IF;
    RETURN the number 0;
END FUNCTION;

^ ====== Helper: Strip surrounding quotes ======
DEFINE function stripQuotes WITH the variable str;
    CALL trim WITH the value of str;
    LET the variable trimmed BE the RESPONSE;
    CALL length WITH the value of trimmed;
    LET the variable len BE the RESPONSE;
    IF the value of len IS greater than or equal to the number 2 THEN
        CALL charAt WITH the value of trimmed, the number 0;
        LET the variable first BE the RESPONSE;
        CALL charAt WITH the value of trimmed, the value of len minus the number 1;
        LET the variable last BE the RESPONSE;
        IF the value of first IS equal to the value of last THEN
            CALL substring WITH the value of trimmed, the number 1, the value of len minus the number 1;
            LET the variable unquoted BE the RESPONSE;
            RETURN the value of unquoted;
        END IF;
    END IF;
    RETURN the value of trimmed;
END FUNCTION;

DEFINE function moduleSymbolKey WITH the variable moduleId, the variable kind, the variable name;
    RETURN the value of moduleId plus the string ":" plus the value of kind plus the string ":" plus the value of name;
END FUNCTION;

DEFINE function privateSymbolStorage WITH the variable name, the variable kind;
    CALL moduleSymbolKey WITH the value of g_currentModuleId, the value of kind, the value of name;
    LET the variable key BE the RESPONSE;
    CALL mapGet WITH the value of key, the value of g_privateStorage;
    RETURN the RESPONSE;
END FUNCTION;

DEFINE function privateAccessDenied WITH the variable name, the variable kind;
    CALL moduleSymbolKey WITH the value of g_currentModuleId, the value of kind, the value of name;
    LET the variable localKey BE the RESPONSE;
    CALL mapGet WITH the value of localKey, the value of g_moduleDeclarations;
    IF the RESPONSE IS equal to the number 1 THEN
        RETURN the number 0;
    END IF;
    LET the variable symbolIndex BE the number 0;
    WHILST the value of symbolIndex IS less than the size of g_privateSymbols DO
        CALL getItem WITH the value of symbolIndex, the value of g_privateSymbols;
        LET the variable symbol BE the RESPONSE;
        CALL mapGet WITH "name", the value of symbol;
        LET the variable symbolName BE the RESPONSE;
        CALL mapGet WITH "kind", the value of symbol;
        LET the variable symbolKind BE the RESPONSE;
        CALL mapGet WITH "moduleId", the value of symbol;
        LET the variable symbolModule BE the RESPONSE;
        IF the value of symbolName IS equal to the value of name THEN
            IF the value of symbolKind IS equal to the value of kind THEN
                IF the value of symbolModule IS not equal to the value of g_currentModuleId THEN
                    RETURN the number 1;
                END IF;
            END IF;
        END IF;
        SET the variable symbolIndex TO the value of symbolIndex plus the number 1;
    END WHILST;
    RETURN the number 0;
END FUNCTION;

DEFINE function privateAccessError WITH the variable name, the variable kind;
    RETURN the string "deny_private_access(" plus the value of QUOTE plus the string "MidShake Access Error: " plus the value of kind plus the string " '" plus the value of name plus the string "' is Private in an imported file." plus the value of QUOTE plus the string ")";
END FUNCTION;

^ ====== Helper: Build env.set call ======
DEFINE function buildEnvSet WITH the variable name, the variable value;
    CALL privateSymbolStorage WITH the value of name, the string "Variable";
    LET the variable storageName BE the RESPONSE;
    IF the length of storageName IS greater than the number 0 THEN
        LET the variable targetName BE the value of storageName;
    ELSE
        CALL privateAccessDenied WITH the value of name, the string "Variable";
        IF the RESPONSE IS equal to the number 1 THEN
            CALL privateAccessError WITH the value of name, the string "Variable";
            RETURN the RESPONSE plus the string ";";
        END IF;
        LET the variable targetName BE the value of name;
    END IF;
    LET the variable result BE the string "env.set(" plus the value of QUOTE plus the value of targetName plus the value of QUOTE plus the string ", " plus the value of value plus the string ");";
    RETURN the value of result;
END FUNCTION;

^ ====== Helper: Build env.get call ======
DEFINE function buildEnvGet WITH the variable name;
    CALL privateSymbolStorage WITH the value of name, the string "Variable";
    LET the variable storageName BE the RESPONSE;
    IF the length of storageName IS greater than the number 0 THEN
        RETURN the string "env.get(" plus the value of QUOTE plus the value of storageName plus the value of QUOTE plus the string ")";
    END IF;
    CALL privateAccessDenied WITH the value of name, the string "Variable";
    IF the RESPONSE IS equal to the number 1 THEN
        CALL privateAccessError WITH the value of name, the string "Variable";
        RETURN the RESPONSE;
    END IF;
    RETURN the string "env.get(" plus the value of QUOTE plus the value of name plus the value of QUOTE plus the string ")";
END FUNCTION;

DEFINE function compileMemberPath WITH the variable path;
    CALL split WITH the value of path, the string ".";
    LET the variable pathParts BE the RESPONSE;
    CALL getItem WITH the number 0, the value of pathParts;
    LET the variable rootName BE the RESPONSE;
    CALL buildEnvGet WITH the value of rootName;
    LET the variable result BE the RESPONSE;
    LET the variable pathIndex BE the number 1;
    LET the variable pathCount BE the size of pathParts;
    WHILST the value of pathIndex IS less than the value of pathCount DO
        CALL getItem WITH the value of pathIndex, the value of pathParts;
        LET the variable memberName BE the RESPONSE;
        SET the variable result TO the string "object_get_member(" plus the value of result plus the string ", " plus the value of QUOTE plus the value of memberName plus the value of QUOTE plus the string ", " plus the value of QUOTE plus the value of g_currentClass plus the value of QUOTE plus the string ")";
        SET the variable pathIndex TO the value of pathIndex plus the number 1;
    END WHILST;
    RETURN the value of result;
END FUNCTION;

DEFINE function accessLevel WITH the variable visibility;
    IF the value of visibility IS equal to the string "Public" THEN
        RETURN the string "AccessLevel::Public";
    END IF;
    IF the value of visibility IS equal to the string "Protected" THEN
        RETURN the string "AccessLevel::Protected";
    END IF;
    RETURN the string "AccessLevel::Private";
END FUNCTION;

DEFINE function classConstructorCallsBase WITH the variable classNode;
    CALL mapGet WITH "members", the value of classNode;
    LET the variable members BE the RESPONSE;
    LET the variable memberIndex BE the number 0;
    WHILST the value of memberIndex IS less than the size of members DO
        CALL getItem WITH the value of memberIndex, the value of members;
        LET the variable member BE the RESPONSE;
        CALL mapGet WITH "type", the value of member;
        LET the variable memberType BE the RESPONSE;
        CALL mapGet WITH "name", the value of member;
        LET the variable memberName BE the RESPONSE;
        IF the value of memberType IS equal to the string "FunctionDef" THEN
            IF the value of memberName IS equal to the string "constructor" THEN
                CALL mapGet WITH "body", the value of member;
                LET the variable body BE the RESPONSE;
                IF the size of body IS greater than the number 0 THEN
                    CALL getItem WITH the number 0, the value of body;
                    LET the variable firstStatement BE the RESPONSE;
                    CALL mapGet WITH "type", the value of firstStatement;
                    LET the variable firstType BE the RESPONSE;
                    CALL mapGet WITH "name", the value of firstStatement;
                    LET the variable firstName BE the RESPONSE;
                    IF the value of firstType IS equal to the string "Call" THEN
                        IF the value of firstName IS equal to the string "super.constructor" THEN
                            RETURN the number 1;
                        END IF;
                    END IF;
                END IF;
                RETURN the number 0;
            END IF;
        END IF;
        SET the variable memberIndex TO the value of memberIndex plus the number 1;
    END WHILST;
    RETURN the number 0;
END FUNCTION;

^ ====== Helper: Build Value::from_string("...") ======
DEFINE function buildStringLit WITH the variable content;
    CALL cpp_unescape_string WITH the value of content;
    LET the variable decodedContent BE the RESPONSE;
    CALL cpp_escape_string WITH the value of decodedContent;
    LET the variable escapedContent BE the RESPONSE;
    LET the variable result BE the string "Value::from_string(" plus the value of QUOTE plus the value of escapedContent plus the value of QUOTE plus the string ")";
    RETURN the value of result;
END FUNCTION;

DEFINE function findOperatorOutsideString WITH the variable text, the variable needle;
    CALL length WITH the value of text;
    LET the variable textLength BE the RESPONSE;
    CALL length WITH the value of needle;
    LET the variable needleLength BE the RESPONSE;
    LET the variable scanIndex BE the number 0;
    LET the variable inString BE the number 0;
    LET the variable foundIndex BE the number -1;

    WHILST the value of scanIndex IS less than the value of textLength DO
        CALL charAt WITH the value of text, the value of scanIndex;
        LET the variable currentChar BE the RESPONSE;
        IF the value of currentChar IS equal to the value of QUOTE THEN
            IF the value of inString IS equal to the number 0 THEN
                SET the variable inString TO the number 1;
            ELSE
                SET the variable inString TO the number 0;
            END IF;
        ELSE
            IF the value of inString IS equal to the number 0 THEN
                IF the value of foundIndex IS less than the number 0 THEN
                    CALL substring WITH the value of text, the value of scanIndex, the value of scanIndex plus the value of needleLength;
                    LET the variable candidate BE the RESPONSE;
                    IF the value of candidate IS equal to the value of needle THEN
                        SET the variable foundIndex TO the value of scanIndex;
                    END IF;
                END IF;
            END IF;
        END IF;
        SET the variable scanIndex TO the value of scanIndex plus the number 1;
    END WHILST;
    RETURN the value of foundIndex;
END FUNCTION;

DEFINE function isTopLevelArgument WITH the variable parenDepth, the variable bracketDepth, the variable braceDepth;
    IF the value of parenDepth IS not equal to the number 0 THEN
        RETURN the number 0;
    END IF;
    IF the value of bracketDepth IS not equal to the number 0 THEN
        RETURN the number 0;
    END IF;
    IF the value of braceDepth IS not equal to the number 0 THEN
        RETURN the number 0;
    END IF;
    RETURN the number 1;
END FUNCTION;

DEFINE function splitCallArgs WITH the variable text;
    CALL length WITH the value of text;
    LET the variable textLength BE the RESPONSE;
    LET the variable pieces BE [];
    LET the variable scanIndex BE the number 0;
    LET the variable partStart BE the number 0;
    LET the variable inString BE the number 0;
    LET the variable parenDepth BE the number 0;
    LET the variable bracketDepth BE the number 0;
    LET the variable braceDepth BE the number 0;

    WHILST the value of scanIndex IS less than the value of textLength DO
        CALL charAt WITH the value of text, the value of scanIndex;
        LET the variable currentChar BE the RESPONSE;
        IF the value of currentChar IS equal to the value of QUOTE THEN
            IF the value of inString IS equal to the number 0 THEN
                SET the variable inString TO the number 1;
            ELSE
                SET the variable inString TO the number 0;
            END IF;
        ELSE
            IF the value of inString IS equal to the number 0 THEN
                IF the value of currentChar IS equal to the string "(" THEN
                    SET the variable parenDepth TO the value of parenDepth plus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string ")" THEN
                    SET the variable parenDepth TO the value of parenDepth minus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string "[" THEN
                    SET the variable bracketDepth TO the value of bracketDepth plus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string "]" THEN
                    SET the variable bracketDepth TO the value of bracketDepth minus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string "{" THEN
                    SET the variable braceDepth TO the value of braceDepth plus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string "}" THEN
                    SET the variable braceDepth TO the value of braceDepth minus the number 1;
                END IF;
                IF the value of currentChar IS equal to the string "," THEN
                    CALL isTopLevelArgument WITH the value of parenDepth, the value of bracketDepth, the value of braceDepth;
                    IF the RESPONSE IS equal to the number 1 THEN
                        CALL substring WITH the value of text, the value of partStart, the value of scanIndex;
                        LET the variable part BE the RESPONSE;
                        CALL append WITH the value of part, the value of pieces;
                        SET the variable pieces TO the RESPONSE;
                        SET the variable partStart TO the value of scanIndex plus the number 1;
                    END IF;
                END IF;
            END IF;
        END IF;
        SET the variable scanIndex TO the value of scanIndex plus the number 1;
    END WHILST;

    CALL substring WITH the value of text, the value of partStart, the value of textLength;
    LET the variable finalPart BE the RESPONSE;
    IF the length of finalPart IS greater than the number 0 THEN
        CALL append WITH the value of finalPart, the value of pieces;
        SET the variable pieces TO the RESPONSE;
    END IF;
    RETURN the value of pieces;
END FUNCTION;

^ ====== Compile an expression string to C++ ======
^ Stores results in g_compiled so nested calls preserve expression compilation state
DEFINE function compileExpr WITH the variable expr;
    CALL trim WITH the value of expr;
    LET the variable trimmed BE the RESPONSE;
    CALL length WITH the value of trimmed;
    LET the variable trimmedLength BE the RESPONSE;
    IF the value of trimmedLength IS greater than the number 0 THEN
        CALL charAt WITH the value of trimmed, the value of trimmedLength minus the number 1;
        LET the variable finalChar BE the RESPONSE;
        IF the value of finalChar IS equal to the string ";" THEN
            CALL substring WITH the value of trimmed, the number 0, the value of trimmedLength minus the number 1;
            SET the variable trimmed TO the RESPONSE;
        END IF;
    END IF;
    GLOBAL SET the variable g_compiled TO the value of trimmed;
    LET the variable cleaned BE the value of g_compiled;
    LET the variable normalized BE the value of cleaned;

    CALL charAt WITH the value of normalized, the number 0;
    LET the variable firstChar BE the RESPONSE;
    IF the value of firstChar IS equal to the value of QUOTE THEN
        CALL stripQuotes WITH the value of normalized;
        LET the variable rawStringContent BE the RESPONSE;
        CALL buildStringLit WITH the value of rawStringContent;
        LET the variable quotedString BE the RESPONSE;
        GLOBAL SET the variable g_compiled TO the value of quotedString;
        RETURN the value of quotedString;
    END IF;

    IF the value of normalized IS equal to the string "[]" THEN
        GLOBAL SET the variable g_compiled TO the string "Value::from_list({})";
        RETURN the value of g_compiled;
    END IF;
    IF the value of normalized IS equal to the string "{}" THEN
        GLOBAL SET the variable g_compiled TO the string "Value::from_map({})";
        RETURN the value of g_compiled;
    END IF;

    CALL findOperatorOutsideString WITH the value of normalized, the string " plus ";
    LET the variable plusIndex BE the RESPONSE;
    IF the value of plusIndex IS greater than the number -1 THEN
        CALL substring WITH the value of normalized, the number 0, the value of plusIndex;
        LET the variable plusLeft BE the RESPONSE;
        CALL compileExpr WITH the value of plusLeft;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL substring WITH the value of normalized, the value of plusIndex plus the number 6, the length of normalized;
        LET the variable plusRight BE the RESPONSE;
        CALL compileExpr WITH the value of plusRight;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "(" plus the value of compiledLeft plus the string " + " plus the value of compiledRight plus the string ")";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    CALL findOperatorOutsideString WITH the value of normalized, the string " minus ";
    LET the variable minusIndex BE the RESPONSE;
    IF the value of minusIndex IS greater than the number -1 THEN
        CALL substring WITH the value of normalized, the number 0, the value of minusIndex;
        LET the variable minusLeft BE the RESPONSE;
        CALL compileExpr WITH the value of minusLeft;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL substring WITH the value of normalized, the value of minusIndex plus the number 7, the length of normalized;
        LET the variable minusRight BE the RESPONSE;
        CALL compileExpr WITH the value of minusRight;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "Value(Number(" plus the value of compiledLeft plus the string ".num.value - " plus the value of compiledRight plus the string ".num.value))";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    CALL findOperatorOutsideString WITH the value of normalized, the string " times ";
    LET the variable timesIndex BE the RESPONSE;
    IF the value of timesIndex IS greater than the number -1 THEN
        CALL substring WITH the value of normalized, the number 0, the value of timesIndex;
        LET the variable timesLeft BE the RESPONSE;
        CALL compileExpr WITH the value of timesLeft;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL substring WITH the value of normalized, the value of timesIndex plus the number 7, the length of normalized;
        LET the variable timesRight BE the RESPONSE;
        CALL compileExpr WITH the value of timesRight;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "Value::from_double(" plus the value of compiledLeft plus the string ".num.value * " plus the value of compiledRight plus the string ".num.value)";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    CALL findOperatorOutsideString WITH the value of normalized, the string " divided by ";
    LET the variable divideIndex BE the RESPONSE;
    IF the value of divideIndex IS greater than the number -1 THEN
        CALL substring WITH the value of normalized, the number 0, the value of divideIndex;
        LET the variable divideLeft BE the RESPONSE;
        CALL compileExpr WITH the value of divideLeft;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL substring WITH the value of normalized, the value of divideIndex plus the number 12, the length of normalized;
        LET the variable divideRight BE the RESPONSE;
        CALL compileExpr WITH the value of divideRight;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "Value::from_double(" plus the value of compiledLeft plus the string ".num.value / " plus the value of compiledRight plus the string ".num.value)";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the string ..."
    CALL startsWith WITH the value of normalized, the string "the string";
    LET the variable isString BE the RESPONSE;
    IF the value of isString IS equal to the number 1 THEN
        CALL length WITH the string "the string";
        LET the variable prefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of prefixLen, the length of normalized;
        LET the variable strContent BE the RESPONSE;
        CALL trim WITH the value of strContent;
        LET the variable trimmedStr BE the RESPONSE;
        CALL stripQuotes WITH the value of trimmedStr;
        LET the variable unquoted BE the RESPONSE;
        CALL buildStringLit WITH the value of unquoted;
        LET the variable result BE the RESPONSE;
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the number N"
    CALL startsWith WITH the value of normalized, the string "the number";
    LET the variable isNumber BE the RESPONSE;
    IF the value of isNumber IS equal to the number 1 THEN
        CALL length WITH the string "the number";
        LET the variable numPrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of numPrefixLen, the length of normalized;
        LET the variable numStr BE the RESPONSE;
        CALL trim WITH the value of numStr;
        LET the variable trimmedNum BE the RESPONSE;
        LET the variable result BE the string "Value::from_double(" plus the value of trimmedNum plus the string ")";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the value of VARIABLE"
    CALL startsWith WITH the value of normalized, the string "the value of";
    LET the variable isValueOf BE the RESPONSE;
    IF the value of isValueOf IS equal to the number 1 THEN
        CALL length WITH the string "the value of";
        LET the variable valPrefixLen BE the RESPONSE;
        CALL findOperatorOutsideString WITH the value of normalized, the string " in ";
        LET the variable mapSeparator BE the RESPONSE;
        IF the value of mapSeparator IS greater than the number -1 THEN
            CALL substring WITH the value of normalized, the value of valPrefixLen, the value of mapSeparator;
            LET the variable keyExpr BE the RESPONSE;
            CALL trim WITH the value of keyExpr;
            LET the variable keyText BE the RESPONSE;
            CALL substring WITH the value of normalized, the value of mapSeparator plus the number 4, the length of normalized;
            LET the variable mapExpr BE the RESPONSE;
            CALL trim WITH the value of mapExpr;
            LET the variable trimmedMapExpr BE the RESPONSE;
            CALL compileExpr WITH the value of trimmedMapExpr;
            LET the variable compiledMap BE the value of g_compiled;
            CALL buildStringLit WITH the value of keyText;
            LET the variable compiledKey BE the RESPONSE;
            LET the variable mapResult BE the string "map_get(" plus the value of compiledMap plus the string ", " plus the value of compiledKey plus the string ")";
            GLOBAL SET the variable g_compiled TO the value of mapResult;
            RETURN the value of mapResult;
        END IF;
        CALL substring WITH the value of normalized, the value of valPrefixLen, the length of normalized;
        LET the variable varName BE the RESPONSE;
        CALL trim WITH the value of varName;
        LET the variable trimmedVar BE the RESPONSE;
        CALL split WITH the value of trimmedVar, the string ".";
        LET the variable varParts BE the RESPONSE;
        IF the size of varParts IS greater than the number 1 THEN
            CALL compileMemberPath WITH the value of trimmedVar;
            LET the variable result BE the RESPONSE;
        ELSE
            CALL buildEnvGet WITH the value of trimmedVar;
            LET the variable result BE the RESPONSE;
        END IF;
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the RESPONSE"
    CALL startsWith WITH the value of normalized, the string "the RESPONSE";
    LET the variable isResponse BE the RESPONSE;
    IF the value of isResponse IS equal to the number 1 THEN
        CALL buildEnvGet WITH "RESPONSE";
        LET the variable result BE the RESPONSE;
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    ^ "the new Class [WITH arguments]"
    CALL startsWith WITH the value of normalized, the string "the new ";
    LET the variable isNewInstance BE the RESPONSE;
    IF the value of isNewInstance IS equal to the number 1 THEN
        CALL substring WITH the value of normalized, the number 8, the length of normalized;
        LET the variable newDeclaration BE the RESPONSE;
        CALL findOperatorOutsideString WITH the value of newDeclaration, the string " WITH ";
        LET the variable constructorArgsIndex BE the RESPONSE;
        LET the variable className BE the value of newDeclaration;
        LET the variable constructorArgs BE the string "";
        IF the value of constructorArgsIndex IS greater than the number -1 THEN
            CALL substring WITH the value of newDeclaration, the number 0, the value of constructorArgsIndex;
            SET the variable className TO the RESPONSE;
            CALL substring WITH the value of newDeclaration, the value of constructorArgsIndex plus the number 6, the length of newDeclaration;
            SET the variable constructorArgs TO the RESPONSE;
        END IF;
        CALL trim WITH the value of className;
        SET the variable className TO the RESPONSE;
        LET the variable compiledArgs BE the string "";
        IF the length of constructorArgs IS greater than the number 0 THEN
            CALL splitCallArgs WITH the value of constructorArgs;
            LET the variable constructorArgParts BE the RESPONSE;
            LET the variable constructorArgCount BE the size of constructorArgParts;
            LET the variable constructorArgIndex BE the number 0;
            WHILST the value of constructorArgIndex IS less than the value of constructorArgCount DO
                CALL getItem WITH the value of constructorArgIndex, the value of constructorArgParts;
                LET the variable constructorArg BE the RESPONSE;
                CALL trim WITH the value of constructorArg;
                LET the variable trimmedConstructorArg BE the RESPONSE;
                CALL compileExpr WITH the value of trimmedConstructorArg;
                LET the variable compiledConstructorArg BE the value of g_compiled;
                IF the value of constructorArgIndex IS greater than the number 0 THEN
                    SET the variable compiledArgs TO the value of compiledArgs plus the string ", ";
                END IF;
                SET the variable compiledArgs TO the value of compiledArgs plus the value of compiledConstructorArg;
                SET the variable constructorArgIndex TO the value of constructorArgIndex plus the number 1;
            END WHILST;
        END IF;
        LET the variable result BE the string "create_object(env, " plus the value of QUOTE plus the value of className plus the value of QUOTE plus the string ", std::vector<Value>{" plus the value of compiledArgs plus the string "})";
        CALL privateAccessDenied WITH the value of className, the string "Class";
        IF the RESPONSE IS equal to the number 1 THEN
            CALL privateAccessError WITH the value of className, the string "Class";
            SET the variable result TO the RESPONSE;
        END IF;
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the length of X"
    CALL startsWith WITH the value of normalized, the string "the length of";
    LET the variable isLength BE the RESPONSE;
    IF the value of isLength IS equal to the number 1 THEN
        CALL length WITH the string "the length of";
        LET the variable lenPrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of lenPrefixLen, the length of normalized;
        LET the variable arg BE the RESPONSE;
        CALL trim WITH the value of arg;
        LET the variable trimmedArg BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedArg;
        LET the variable compiledArg BE the value of g_compiled;
        LET the variable result BE the string "string_length(" plus the value of compiledArg plus the string ")";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "the size of X"
    CALL startsWith WITH the value of normalized, the string "the size of";
    LET the variable isSize BE the RESPONSE;
    IF the value of isSize IS equal to the number 1 THEN
        CALL length WITH the string "the size of";
        LET the variable sizePrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of sizePrefixLen, the length of normalized;
        LET the variable arg BE the RESPONSE;
        CALL trim WITH the value of arg;
        LET the variable trimmedArg BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedArg;
        LET the variable compiledArg BE the value of g_compiled;
        LET the variable result BE the string "list_length(" plus the value of compiledArg plus the string ")";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    CALL startsWith WITH the value of normalized, the string "the character at";
    LET the variable isCharacterAt BE the RESPONSE;
    IF the value of isCharacterAt IS equal to the number 1 THEN
        CALL length WITH the string "the character at";
        LET the variable characterPrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of characterPrefixLen, the length of normalized;
        LET the variable characterArgs BE the RESPONSE;
        CALL findOperatorOutsideString WITH the value of characterArgs, the string " in ";
        LET the variable characterSeparator BE the RESPONSE;
        IF the value of characterSeparator IS greater than the number -1 THEN
            CALL substring WITH the value of characterArgs, the number 0, the value of characterSeparator;
            LET the variable characterIndexExpr BE the RESPONSE;
            CALL trim WITH the value of characterIndexExpr;
            LET the variable trimmedCharacterIndex BE the RESPONSE;
            CALL substring WITH the value of characterArgs, the value of characterSeparator plus the number 4, the length of characterArgs;
            LET the variable characterStringExpr BE the RESPONSE;
            CALL trim WITH the value of characterStringExpr;
            LET the variable trimmedCharacterString BE the RESPONSE;
            CALL compileExpr WITH the value of trimmedCharacterIndex;
            LET the variable compiledCharacterIndex BE the value of g_compiled;
            CALL compileExpr WITH the value of trimmedCharacterString;
            LET the variable compiledCharacterString BE the value of g_compiled;
            LET the variable characterResult BE the string "char_at(" plus the value of compiledCharacterString plus the string ", " plus the value of compiledCharacterIndex plus the string ")";
            GLOBAL SET the variable g_compiled TO the value of characterResult;
            RETURN the value of characterResult;
        END IF;
    END IF;
    
    CALL startsWith WITH the value of normalized, the string "the content of the file";
    LET the variable isSingularFileRead BE the RESPONSE;
    IF the value of isSingularFileRead IS equal to the number 1 THEN
        CALL length WITH the string "the content of the file";
        LET the variable singularPrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of singularPrefixLen, the length of normalized;
        LET the variable singularPathExpr BE the RESPONSE;
        CALL trim WITH the value of singularPathExpr;
        LET the variable trimmedSingularPath BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedSingularPath;
        LET the variable compiledSingularPath BE the value of g_compiled;
        LET the variable singularReadResult BE the string "file_read(" plus the value of compiledSingularPath plus the string ".to_string())";
        GLOBAL SET the variable g_compiled TO the value of singularReadResult;
        RETURN the value of singularReadResult;
    END IF;

    ^ "the contents of FILE"
    CALL startsWith WITH the value of normalized, the string "the contents of";
    LET the variable isFileRead BE the RESPONSE;
    IF the value of isFileRead IS equal to the number 1 THEN
        CALL length WITH the string "the contents of";
        LET the variable filePrefixLen BE the RESPONSE;
        CALL substring WITH the value of normalized, the value of filePrefixLen, the length of normalized;
        LET the variable pathExpr BE the RESPONSE;
        CALL trim WITH the value of pathExpr;
        LET the variable trimmedPath BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedPath;
        LET the variable compiledPath BE the value of g_compiled;
        LET the variable result BE the string "file_read(" plus the value of compiledPath plus the string ".to_string())";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ "true" / "false"
    IF the value of normalized IS equal to the string "true" THEN
        GLOBAL SET the variable g_compiled TO "Value::from_double(1)";
        RETURN "Value::from_double(1)";
    END IF;
    IF the value of normalized IS equal to the string "false" THEN
        GLOBAL SET the variable g_compiled TO "Value::from_double(0)";
        RETURN "Value::from_double(0)";
    END IF;
    
    ^ Binary: "X plus Y" — split on " plus " to handle nested expressions
    CALL split WITH the value of normalized, the string " plus ";
    LET the variable plusParts BE the RESPONSE;
    LET the variable plusCount BE the size of plusParts;
    IF the value of plusCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of plusParts;
        LET the variable plusLeft BE the RESPONSE;
        CALL trim WITH the value of plusLeft;
        LET the variable plusLeftTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of plusLeftTrimmed;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL getItem WITH the value of plusCount minus the number 1, the value of plusParts;
        LET the variable plusRight BE the RESPONSE;
        CALL trim WITH the value of plusRight;
        LET the variable plusRightTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of plusRightTrimmed;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "(" plus the value of compiledLeft plus the string " + " plus the value of compiledRight plus the string ")";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;
    
    ^ Binary: "X minus Y" — split on " minus "
    CALL split WITH the value of normalized, the string " minus ";
    LET the variable minusParts BE the RESPONSE;
    LET the variable minusCount BE the size of minusParts;
    IF the value of minusCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of minusParts;
        LET the variable minusLeft BE the RESPONSE;
        CALL trim WITH the value of minusLeft;
        LET the variable minusLeftTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of minusLeftTrimmed;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL getItem WITH the value of minusCount minus the number 1, the value of minusParts;
        LET the variable minusRight BE the RESPONSE;
        CALL trim WITH the value of minusRight;
        LET the variable minusRightTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of minusRightTrimmed;
        LET the variable compiledRight BE the value of g_compiled;
        LET the variable result BE the string "Value(Number(" plus the value of compiledLeft plus the string ".num.value - " plus the value of compiledRight plus the string ".num.value))";
        GLOBAL SET the variable g_compiled TO the value of result;
        RETURN the value of result;
    END IF;

    ^ Fallback: bare variable
    CALL buildEnvGet WITH the value of normalized;
    LET the variable fallback BE the RESPONSE;
    GLOBAL SET the variable g_compiled TO the value of fallback;
    RETURN the value of fallback;
END FUNCTION;

^ ====== Compile a condition to C++ ======
DEFINE function compileCondition WITH the variable condition;
    CALL trim WITH the value of condition;
    LET the variable trimmed BE the RESPONSE;
    CALL replace WITH the value of trimmed, the string " THEN", the string "";
    GLOBAL SET the variable g_compiled TO the RESPONSE;
    LET the variable cleaned BE the value of g_compiled;
    CALL replace WITH the value of cleaned, the string " THEN;", the string "";
    GLOBAL SET the variable g_compiled TO the RESPONSE;
    LET the variable cleaned2 BE the value of g_compiled;
    CALL trim WITH the value of cleaned2;
    LET the variable trimmedCond BE the RESPONSE;

    ^ "X IS equal to Y"
    CALL split WITH the value of trimmed, the string " IS equal to ";
    LET the variable parts BE the RESPONSE;
    LET the variable count BE the size of parts;
    IF the value of count IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of parts;
        LET the variable left BE the RESPONSE;
        CALL trim WITH the value of left;
        LET the variable leftTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of leftTrimmed;
        LET the variable compiledLeft BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of parts;
        LET the variable right BE the RESPONSE;
        CALL trim WITH the value of right;
        LET the variable rightTrimmed BE the RESPONSE;
        CALL compileExpr WITH the value of rightTrimmed;
        LET the variable compiledRight BE the value of g_compiled;
        RETURN the string "value_equals(" plus the value of compiledLeft plus the string ", " plus the value of compiledRight plus the string ")";
    END IF;

    ^ "X IS not equal to Y"
    CALL split WITH the value of trimmed, the string " IS not equal to ";
    LET the variable parts2 BE the RESPONSE;
    LET the variable count2 BE the size of parts2;
    IF the value of count2 IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of parts2;
        LET the variable left2 BE the RESPONSE;
        CALL trim WITH the value of left2;
        LET the variable left2Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of left2Trimmed;
        LET the variable compiledLeft2 BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of parts2;
        LET the variable right2 BE the RESPONSE;
        CALL trim WITH the value of right2;
        LET the variable right2Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of right2Trimmed;
        LET the variable compiledRight2 BE the value of g_compiled;
        RETURN the string "(!value_equals(" plus the value of compiledLeft2 plus the string ", " plus the value of compiledRight2 plus the string "))";
    END IF;

    ^ "X IS less than or equal to Y"
    CALL split WITH the value of trimmed, the string " IS less than or equal to ";
    LET the variable lessEqualParts BE the RESPONSE;
    LET the variable lessEqualCount BE the size of lessEqualParts;
    IF the value of lessEqualCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of lessEqualParts;
        LET the variable lessEqualLeft BE the RESPONSE;
        CALL trim WITH the value of lessEqualLeft;
        LET the variable trimmedLessEqualLeft BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedLessEqualLeft;
        LET the variable compiledLessEqualLeft BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of lessEqualParts;
        LET the variable lessEqualRight BE the RESPONSE;
        CALL trim WITH the value of lessEqualRight;
        LET the variable trimmedLessEqualRight BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedLessEqualRight;
        LET the variable compiledLessEqualRight BE the value of g_compiled;
        RETURN the string "(" plus the value of compiledLessEqualLeft plus the string ".num.value <= " plus the value of compiledLessEqualRight plus the string ".num.value)";
    END IF;

    ^ "X IS less than Y"
    CALL split WITH the value of trimmed, the string " IS less than ";
    LET the variable parts3 BE the RESPONSE;
    LET the variable count3 BE the size of parts3;
    IF the value of count3 IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of parts3;
        LET the variable left3 BE the RESPONSE;
        CALL trim WITH the value of left3;
        LET the variable left3Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of left3Trimmed;
        LET the variable compiledLeft3 BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of parts3;
        LET the variable right3 BE the RESPONSE;
        CALL trim WITH the value of right3;
        LET the variable right3Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of right3Trimmed;
        LET the variable compiledRight3 BE the value of g_compiled;
        RETURN the string "(" plus the value of compiledLeft3 plus the string ".num.value < " plus the value of compiledRight3 plus the string ".num.value)";
    END IF;

    ^ "X IS greater than or equal to Y"
    CALL split WITH the value of trimmed, the string " IS greater than or equal to ";
    LET the variable greaterEqualParts BE the RESPONSE;
    LET the variable greaterEqualCount BE the size of greaterEqualParts;
    IF the value of greaterEqualCount IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of greaterEqualParts;
        LET the variable greaterEqualLeft BE the RESPONSE;
        CALL trim WITH the value of greaterEqualLeft;
        LET the variable trimmedGreaterEqualLeft BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedGreaterEqualLeft;
        LET the variable compiledGreaterEqualLeft BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of greaterEqualParts;
        LET the variable greaterEqualRight BE the RESPONSE;
        CALL trim WITH the value of greaterEqualRight;
        LET the variable trimmedGreaterEqualRight BE the RESPONSE;
        CALL compileExpr WITH the value of trimmedGreaterEqualRight;
        LET the variable compiledGreaterEqualRight BE the value of g_compiled;
        RETURN the string "(" plus the value of compiledGreaterEqualLeft plus the string ".num.value >= " plus the value of compiledGreaterEqualRight plus the string ".num.value)";
    END IF;

    ^ "X IS greater than Y"
    CALL split WITH the value of trimmed, the string " IS greater than ";
    LET the variable parts4 BE the RESPONSE;
    LET the variable count4 BE the size of parts4;
    IF the value of count4 IS greater than the number 1 THEN
        CALL getItem WITH the number 0, the value of parts4;
        LET the variable left4 BE the RESPONSE;
        CALL trim WITH the value of left4;
        LET the variable left4Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of left4Trimmed;
        LET the variable compiledLeft4 BE the value of g_compiled;
        CALL getItem WITH the number 1, the value of parts4;
        LET the variable right4 BE the RESPONSE;
        CALL trim WITH the value of right4;
        LET the variable right4Trimmed BE the RESPONSE;
        CALL compileExpr WITH the value of right4Trimmed;
        LET the variable compiledRight4 BE the value of g_compiled;
        RETURN the string "(" plus the value of compiledLeft4 plus the string ".num.value > " plus the value of compiledRight4 plus the string ".num.value)";
    END IF;

    ^ Fallback
    CALL compileExpr WITH the value of trimmed;
    LET the variable compiledFallback BE the value of g_compiled;
    RETURN the string "(" plus the value of compiledFallback plus the string ".num.value != 0)";
END FUNCTION;

^ ====== Compile a single AST node to C++ ======
DEFINE function resolveCallName WITH the variable callName;
    CALL privateSymbolStorage WITH the value of callName, the string "Function";
    LET the variable privateFunctionSymbol BE the RESPONSE;
    IF the length of privateFunctionSymbol IS greater than the number 0 THEN
        RETURN the value of privateFunctionSymbol;
    END IF;
    CALL mapGet WITH the value of callName, the value of g_functionNames;
    LET the variable isUserFunction BE the RESPONSE;
    IF the value of isUserFunction IS equal to the number 1 THEN
        RETURN the value of callName;
    END IF;
    CALL mapGet WITH the value of callName, the value of g_standardFunctionNames;
    LET the variable isStandardFunction BE the RESPONSE;
    IF the value of isStandardFunction IS equal to the number 1 THEN
        RETURN the string "ms_std_" plus the value of callName;
    END IF;
    RETURN the value of callName;
END FUNCTION;

DEFINE function compileNode WITH the variable node;
    GLOBAL SET the variable g_node TO the value of node;
    CALL mapGet WITH "moduleId", the value of g_node;
    LET the variable nodeModuleId BE the RESPONSE;
    IF the length of nodeModuleId IS greater than the number 0 THEN
        GLOBAL SET the variable g_currentModuleId TO the value of nodeModuleId;
    END IF;
    
    LET the variable nodeType BE the value of type in g_node;
    CALL trim WITH the value of nodeType;
    LET the variable trimmedType BE the RESPONSE;
    SET the variable nodeType TO the value of trimmedType;
    
    ^ --- Let ---
    IF the value of nodeType IS equal to the string "Let" THEN
        LET the variable varName BE the value of name in g_node;
        LET the variable valueExpr BE the value of value in g_node;
        IF the length of valueExpr IS greater than the number 0 THEN
            PROCLAIM the string "";
            CALL compileExpr WITH the value of valueExpr;
        ELSE
            GLOBAL SET the variable g_compiled TO the string "";
        END IF;
        LET the variable compiled BE the value of g_compiled;
        CALL buildEnvSet WITH the value of varName, the value of compiled;
        LET the variable setLine BE the RESPONSE;
        CALL emit WITH the value of setLine;
        RETURN the number 0;
    END IF;
    
    ^ --- GlobalSet ---
    IF the value of nodeType IS equal to the string "GlobalSet" THEN
        LET the variable varName BE the value of name in g_node;
        LET the variable valueExpr BE the value of value in g_node;
        IF the length of valueExpr IS greater than the number 0 THEN
            PROCLAIM the string "";
            CALL compileExpr WITH the value of valueExpr;
        ELSE
            GLOBAL SET the variable g_compiled TO the string "";
        END IF;
        LET the variable compiled BE the value of g_compiled;
        CALL privateSymbolStorage WITH the value of varName, the string "Variable";
        LET the variable globalStorageName BE the RESPONSE;
        IF the length of globalStorageName IS greater than the number 0 THEN
            SET the variable globalTargetName TO the value of globalStorageName;
            LET the variable denyGlobalSet BE the number 0;
        ELSE
            CALL privateAccessDenied WITH the value of varName, the string "Variable";
            LET the variable denyGlobalSet BE the RESPONSE;
            SET the variable globalTargetName TO the value of varName;
        END IF;
        IF the value of denyGlobalSet IS equal to the number 1 THEN
            CALL privateAccessError WITH the value of varName, the string "Variable";
            CALL emit WITH the RESPONSE plus the string ";";
        ELSE
            CALL emit WITH the string "env.set_global(" plus the value of QUOTE plus the value of globalTargetName plus the value of QUOTE plus the string ", " plus the value of compiled plus the string ");";
        END IF;
        RETURN the number 0;
    END IF;

    ^ --- Set ---
    IF the value of nodeType IS equal to the string "Set" THEN
        LET the variable varName BE the value of name in g_node;
        LET the variable valueExpr BE the value of value in g_node;
        IF the length of valueExpr IS greater than the number 0 THEN
            PROCLAIM the string "";
            CALL compileExpr WITH the value of valueExpr;
        ELSE
            GLOBAL SET the variable g_compiled TO the string "";
        END IF;
        LET the variable compiled BE the value of g_compiled;
        CALL split WITH the value of varName, the string ".";
        LET the variable setPathParts BE the RESPONSE;
        LET the variable setPathCount BE the size of setPathParts;
        IF the value of setPathCount IS greater than the number 1 THEN
            CALL getItem WITH the value of setPathCount minus the number 1, the value of setPathParts;
            LET the variable setMemberName BE the RESPONSE;
            LET the variable setTargetName BE the string "";
            LET the variable setPathIndex BE the number 0;
            WHILST the value of setPathIndex IS less than the value of setPathCount minus the number 1 DO
                CALL getItem WITH the value of setPathIndex, the value of setPathParts;
                LET the variable setTargetPart BE the RESPONSE;
                IF the value of setPathIndex IS greater than the number 0 THEN
                    SET the variable setTargetName TO the value of setTargetName plus the string ".";
                END IF;
                SET the variable setTargetName TO the value of setTargetName plus the value of setTargetPart;
                SET the variable setPathIndex TO the value of setPathIndex plus the number 1;
            END WHILST;
            CALL compileMemberPath WITH the value of setTargetName;
            LET the variable compiledSetTarget BE the RESPONSE;
            CALL emit WITH the string "object_set_member(" plus the value of compiledSetTarget plus the string ", " plus the value of QUOTE plus the value of setMemberName plus the value of QUOTE plus the string ", " plus the value of compiled plus the string ", " plus the value of QUOTE plus the value of g_currentClass plus the value of QUOTE plus the string ");";
        ELSE
            CALL buildEnvSet WITH the value of varName, the value of compiled;
            LET the variable setLine BE the RESPONSE;
            CALL emit WITH the value of setLine;
        END IF;
        RETURN the number 0;
    END IF;

    ^ --- MapSet ---
    IF the value of nodeType IS equal to the string "MapSet" THEN
        LET the variable mapName BE the value of map in g_node;
        LET the variable keyExpr BE the value of key in g_node;
        LET the variable mapValueExpr BE the value of value in g_node;
        CALL compileExpr WITH the value of mapName;
        LET the variable compiledMap BE the value of g_compiled;
        CALL compileExpr WITH the value of keyExpr;
        LET the variable compiledKey BE the value of g_compiled;
        CALL compileExpr WITH the value of mapValueExpr;
        LET the variable compiledMapValue BE the value of g_compiled;
        LET the variable mapSetExpr BE the string "map_set(" plus the value of compiledMap plus the string ", " plus the value of compiledKey plus the string ", " plus the value of compiledMapValue plus the string ")";
        IF the value of mapName IS equal to the string "g_node" THEN
            CALL emit WITH the string "env.set_global(" plus the value of QUOTE plus the value of mapName plus the value of QUOTE plus the string ", " plus the value of mapSetExpr plus the string ");";
        ELSE
            CALL buildEnvSet WITH the value of mapName, the value of mapSetExpr;
            LET the variable mapSetLine BE the RESPONSE;
            CALL emit WITH the value of mapSetLine;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ --- Proclaim ---
    IF the value of nodeType IS equal to the string "Proclaim" THEN
        LET the variable valueExpr BE the value of value in g_node;
        IF the length of valueExpr IS greater than the number 0 THEN
            PROCLAIM the string "";
            CALL compileExpr WITH the value of valueExpr;
        ELSE
            GLOBAL SET the variable g_compiled TO the string "";
        END IF;
        LET the variable compiled BE the value of g_compiled;
        CALL emit WITH the string "print(" plus the value of compiled plus the string ");";
        RETURN the number 0;
    END IF;
    
    ^ --- If ---
    IF the value of nodeType IS equal to the string "If" THEN
        LET the variable condition BE the value of condition in g_node;
        LET the variable body BE the value of body in g_node;
        LET the variable condCompiled BE the string "";
        IF the length of condition IS greater than the number 0 THEN
            CALL compileCondition WITH the value of condition;
            LET the variable condResult BE the RESPONSE;
            SET the variable condCompiled TO the value of condResult;
        END IF;
        CALL emit WITH the string "if (" plus the value of condCompiled plus the string ") {";
        CALL indent WITH the number 0;
        LET the variable bodySize BE the size of body;
        LET the variable ifBodyIndex BE the number 0;
        WHILST the value of ifBodyIndex IS less than the value of bodySize DO
            CALL getItem WITH the value of ifBodyIndex, the value of body;
            LET the variable child BE the RESPONSE;
            CALL compileNode WITH the value of child;
            SET the variable ifBodyIndex TO the value of ifBodyIndex plus the number 1;
        END WHILST;
        CALL dedent WITH the number 0;
        ^ Check for else body — only if the key exists
        CALL mapGet WITH "elseBody", the value of node;
        LET the variable elseBody BE the RESPONSE;
        IF the value of elseBody IS not equal to the string "" THEN
            CALL startsWith WITH the value of elseBody, the string "[]";
            LET the variable isEmpty BE the RESPONSE;
            IF the value of isEmpty IS not equal to the number 1 THEN
                CALL emit WITH "} else {";
                CALL indent WITH the number 0;
                LET the variable elseSize BE the size of elseBody;
                LET the variable elseBodyIndex BE the number 0;
                WHILST the value of elseBodyIndex IS less than the value of elseSize DO
                    CALL getItem WITH the value of elseBodyIndex, the value of elseBody;
                    LET the variable elseChild BE the RESPONSE;
                    CALL compileNode WITH the value of elseChild;
                    SET the variable elseBodyIndex TO the value of elseBodyIndex plus the number 1;
                END WHILST;
                CALL dedent WITH the number 0;
                CALL emit WITH "}";
            ELSE
                CALL emit WITH "}";
            END IF;
        ELSE
            CALL emit WITH "}";
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ --- While ---
    IF the value of nodeType IS equal to the string "While" THEN
        LET the variable condition BE the value of condition in g_node;
        LET the variable body BE the value of body in g_node;
        LET the variable condCompiled BE the string "";
        IF the length of condition IS greater than the number 0 THEN
            CALL compileCondition WITH the value of condition;
            LET the variable condResult BE the RESPONSE;
            SET the variable condCompiled TO the value of condResult;
        END IF;
        CALL emit WITH the string "while (" plus the value of condCompiled plus the string ") {";
        CALL indent WITH the number 0;
        LET the variable bodySize BE the size of body;
        LET the variable whileBodyIndex BE the number 0;
        WHILST the value of whileBodyIndex IS less than the value of bodySize DO
            CALL getItem WITH the value of whileBodyIndex, the value of body;
            LET the variable child BE the RESPONSE;
            CALL compileNode WITH the value of child;
            SET the variable whileBodyIndex TO the value of whileBodyIndex plus the number 1;
        END WHILST;
        CALL dedent WITH the number 0;
        CALL emit WITH "}";
        RETURN the number 0;
    END IF;

    ^ --- TryCatch ---
    IF the value of nodeType IS equal to the string "TryCatch" THEN
        LET the variable catchName BE the value of name in g_node;
        LET the variable tryBody BE the value of body in g_node;
        LET the variable catchBody BE the value of catchBody in g_node;
        CALL emit WITH "try {";
        CALL indent WITH the number 0;
        LET the variable tryBodyIndex BE the number 0;
        WHILST the value of tryBodyIndex IS less than the size of tryBody DO
            CALL getItem WITH the value of tryBodyIndex, the value of tryBody;
            LET the variable tryChild BE the RESPONSE;
            CALL compileNode WITH the value of tryChild;
            SET the variable tryBodyIndex TO the value of tryBodyIndex plus the number 1;
        END WHILST;
        CALL dedent WITH the number 0;
        CALL emit WITH "} catch (const ThrownValue& thrown) {";
        CALL indent WITH the number 0;
        CALL emit WITH the string "env.set(" plus the value of QUOTE plus the value of catchName plus the value of QUOTE plus the string ", thrown.value);";
        LET the variable catchBodyIndex BE the number 0;
        WHILST the value of catchBodyIndex IS less than the size of catchBody DO
            CALL getItem WITH the value of catchBodyIndex, the value of catchBody;
            LET the variable catchChild BE the RESPONSE;
            CALL compileNode WITH the value of catchChild;
            SET the variable catchBodyIndex TO the value of catchBodyIndex plus the number 1;
        END WHILST;
        CALL dedent WITH the number 0;
        CALL emit WITH "}";
        RETURN the number 0;
    END IF;
    
    ^ --- FunctionDef (collect, don't emit yet) ---
    IF the value of nodeType IS equal to the string "FunctionDef" THEN
        CALL append WITH the value of g_node, the value of g_functions;
        LET the variable newFuncs BE the RESPONSE;
        GLOBAL SET the variable g_functions TO the value of newFuncs;
        RETURN the number 0;
    END IF;
    
    ^ --- Call ---
    IF the value of nodeType IS equal to the string "Call" THEN
        LET the variable callName BE the value of name in g_node;
        LET the variable callArgs BE the value of value in g_node;
        CALL privateAccessDenied WITH the value of callName, the string "Function";
        IF the RESPONSE IS equal to the number 1 THEN
            CALL privateAccessError WITH the value of callName, the string "Function";
            CALL emit WITH the RESPONSE plus the string ";";
            RETURN the number 0;
        END IF;
        CALL emit WITH "{";
        CALL indent WITH the number 0;
        CALL emit WITH "std::vector<Value> args;";
        IF the length of callArgs IS greater than the number 0 THEN
            CALL splitCallArgs WITH the value of callArgs;
            LET the variable argParts BE the RESPONSE;
            LET the variable argCount BE the size of argParts;
            LET the variable callArgIndex BE the number 0;
            WHILST the value of callArgIndex IS less than the value of argCount DO
                CALL getItem WITH the value of callArgIndex, the value of argParts;
                LET the variable argPart BE the RESPONSE;
                CALL trim WITH the value of argPart;
                LET the variable trimmedArg BE the RESPONSE;
                IF the length of trimmedArg IS greater than the number 0 THEN
                    PROCLAIM the string "";
                    CALL compileExpr WITH the value of trimmedArg;
                    LET the variable compiledArg BE the value of g_compiled;
                    CALL emit WITH the string "args.push_back(" plus the value of compiledArg plus the string ");";
                END IF;
                SET the variable callArgIndex TO the value of callArgIndex plus the number 1;
            END WHILST;
        END IF;
        CALL split WITH the value of callName, the string ".";
        LET the variable callPathParts BE the RESPONSE;
        LET the variable callPathCount BE the size of callPathParts;
        IF the value of callPathCount IS greater than the number 1 THEN
            IF the value of callName IS equal to the string "super.constructor" THEN
                IF the length of g_currentClass IS greater than the number 0 THEN
                    CALL emit WITH the string "call_base_constructor(env, env.get(" plus the value of QUOTE plus the string "this" plus the value of QUOTE plus the string "), " plus the value of QUOTE plus the value of g_currentClass plus the value of QUOTE plus the string ", args);";
                    CALL emit WITH the string "env.set(" plus the value of QUOTE plus the string "RESPONSE" plus the value of QUOTE plus the string ", Value::from_double(0));";
                ELSE
                    CALL emit WITH "throw std::runtime_error(\"'super.constructor' can only be called from a class constructor.\");";
                END IF;
            ELSE
                CALL getItem WITH the value of callPathCount minus the number 1, the value of callPathParts;
                LET the variable methodName BE the RESPONSE;
                LET the variable methodTargetName BE the string "";
                LET the variable methodPathIndex BE the number 0;
                WHILST the value of methodPathIndex IS less than the value of callPathCount minus the number 1 DO
                    CALL getItem WITH the value of methodPathIndex, the value of callPathParts;
                    LET the variable methodTargetPart BE the RESPONSE;
                    IF the value of methodPathIndex IS greater than the number 0 THEN
                        SET the variable methodTargetName TO the value of methodTargetName plus the string ".";
                    END IF;
                    SET the variable methodTargetName TO the value of methodTargetName plus the value of methodTargetPart;
                    SET the variable methodPathIndex TO the value of methodPathIndex plus the number 1;
                END WHILST;
                CALL compileMemberPath WITH the value of methodTargetName;
                LET the variable compiledMethodTarget BE the RESPONSE;
                CALL emit WITH the string "env.set(" plus the value of QUOTE plus the string "RESPONSE" plus the value of QUOTE plus the string ", call_object_method(env, " plus the value of compiledMethodTarget plus the string ", " plus the value of QUOTE plus the value of methodName plus the value of QUOTE plus the string ", args, " plus the value of QUOTE plus the value of g_currentClass plus the value of QUOTE plus the string "));";
            END IF;
        ELSE
            CALL resolveCallName WITH the value of callName;
            LET the variable emittedCallName BE the RESPONSE;
            CALL emit WITH the string "env.set(" plus the value of QUOTE plus the string "RESPONSE" plus the value of QUOTE plus the string ", " plus the value of emittedCallName plus the string "(env, args));";
        END IF;
        CALL dedent WITH the number 0;
        CALL emit WITH "}";
        RETURN the number 0;
    END IF;
    
    ^ --- Throw ---
    IF the value of nodeType IS equal to the string "Throw" THEN
        LET the variable throwExpr BE the value of value in g_node;
        CALL compileExpr WITH the value of throwExpr;
        LET the variable compiledThrow BE the value of g_compiled;
        CALL emit WITH the string "throw ThrownValue(" plus the value of compiledThrow plus the string ");";
        RETURN the number 0;
    END IF;

    ^ --- Return ---
    IF the value of nodeType IS equal to the string "Return" THEN
        LET the variable returnExpr BE the value of value in g_node;
        IF the length of returnExpr IS greater than the number 0 THEN
            PROCLAIM the string "";
            CALL compileExpr WITH the value of returnExpr;
        ELSE
            GLOBAL SET the variable g_compiled TO the string "";
        END IF;
        LET the variable compiled BE the value of g_compiled;
        CALL emit WITH the string "return " plus the value of compiled plus the string ";";
        RETURN the number 0;
    END IF;
    
    ^ --- Break ---
    IF the value of nodeType IS equal to the string "Break" THEN
        CALL emit WITH "break;";
        RETURN the number 0;
    END IF;
    
    ^ --- Continue ---
    IF the value of nodeType IS equal to the string "Continue" THEN
        CALL emit WITH "continue;";
        RETURN the number 0;
    END IF;
    
    ^ --- Terminate ---
    IF the value of nodeType IS equal to the string "Terminate" THEN
        CALL emit WITH "return Value::from_double(0);";
        RETURN the number 0;
    END IF;
    
    ^ --- ForIn ---
    IF the value of nodeType IS equal to the string "ForIn" THEN
        LET the variable header BE the value of header in g_node;
        LET the variable body BE the value of body in g_node;
        CALL split WITH the value of header, the string " ";
        LET the variable headerParts BE the RESPONSE;
        LET the variable headerCount BE the size of headerParts;
        LET the variable forHeaderIndex BE the number 0;
        LET the variable foundVar BE the number 0;
        LET the variable forVarName BE the string "";
        WHILST the value of forHeaderIndex IS less than the value of headerCount DO
            CALL getItem WITH the value of forHeaderIndex, the value of headerParts;
            LET the variable part BE the RESPONSE;
            IF the value of foundVar IS equal to the number 1 THEN
                SET the variable forVarName TO the value of part;
                SET the variable foundVar TO the number 2;
            END IF;
            IF the value of part IS equal to the string "variable" THEN
                SET the variable foundVar TO the number 1;
            END IF;
            SET the variable forHeaderIndex TO the value of forHeaderIndex plus the number 1;
        END WHILST;
        LET the variable foundIn BE the number 0;
        LET the variable forListExpr BE the string "";
        LET the variable forListIndex BE the number 0;
        WHILST the value of forListIndex IS less than the value of headerCount DO
            CALL getItem WITH the value of forListIndex, the value of headerParts;
            LET the variable part BE the RESPONSE;
            IF the value of foundIn IS equal to the number 1 THEN
                IF the length of forListExpr IS greater than the number 0 THEN
                    SET the variable forListExpr TO the value of forListExpr plus the string " ";
                END IF;
                SET the variable forListExpr TO the value of forListExpr plus the value of part;
            END IF;
            IF the value of part IS equal to the string "IN" THEN
                SET the variable foundIn TO the number 1;
            END IF;
            SET the variable forListIndex TO the value of forListIndex plus the number 1;
        END WHILST;
        CALL emit WITH the string "for (const auto& " plus the value of forVarName plus the string " : " plus the value of forListExpr plus the string ".lst) {";
        CALL indent WITH the number 0;
        CALL buildEnvSet WITH the value of forVarName, the value of forVarName;
        LET the variable setVar BE the RESPONSE;
        CALL emit WITH the value of setVar;
        LET the variable bodySize BE the size of body;
        LET the variable forBodyIndex BE the number 0;
        WHILST the value of forBodyIndex IS less than the value of bodySize DO
            CALL getItem WITH the value of forBodyIndex, the value of body;
            LET the variable child BE the RESPONSE;
            CALL compileNode WITH the value of child;
            SET the variable forBodyIndex TO the value of forBodyIndex plus the number 1;
        END WHILST;
        CALL dedent WITH the number 0;
        CALL emit WITH "}";
        RETURN the number 0;
    END IF;
    
    ^ --- FileWrite ---
    IF the value of nodeType IS equal to the string "FileWrite" THEN
        LET the variable fileWriteExpr BE the value of value in g_node;
        CALL split WITH the value of fileWriteExpr, the string "WRITE";
        LET the variable writeParts BE the RESPONSE;
        LET the variable writeCount BE the size of writeParts;
        IF the value of writeCount IS greater than the number 1 THEN
            CALL getItem WITH the number 1, the value of writeParts;
            LET the variable writeContentExpr BE the RESPONSE;
            CALL trim WITH the value of writeContentExpr;
            LET the variable trimmedContent BE the RESPONSE;
            ^ Compile the content expression to C++
            PROCLAIM the string "";
            CALL compileExpr WITH the value of trimmedContent;
            LET the variable compiledContent BE the value of g_compiled;
            CALL getItem WITH the number 0, the value of writeParts;
            LET the variable filePart BE the RESPONSE;
            CALL split WITH the value of filePart, the string "file";
            LET the variable fileSplitParts BE the RESPONSE;
            LET the variable fileSplitCount BE the size of fileSplitParts;
            IF the value of fileSplitCount IS greater than the number 1 THEN
                CALL getItem WITH the value of fileSplitCount minus the number 1, the value of fileSplitParts;
                LET the variable filePathRaw BE the RESPONSE;
                CALL trim WITH the value of filePathRaw;
                LET the variable trimmedPath BE the RESPONSE;
                CALL stripQuotes WITH the value of trimmedPath;
                LET the variable unquotedPath BE the RESPONSE;
                LET the variable fwLine BE the string "file_write(" plus the value of QUOTE plus the value of unquotedPath plus the value of QUOTE plus the string ", " plus the value of compiledContent plus the string ");";
                CALL emit WITH the value of fwLine;
            END IF;
        END IF;
        RETURN the number 0;
    END IF;
    
    ^ --- Import (skip) ---
    IF the value of nodeType IS equal to the string "Import" THEN
        RETURN the number 0;
    END IF;
    
    RETURN the number 0;
END FUNCTION;

^ ====== Compile a function definition to C++ ======
DEFINE function compileFunctionDef WITH the variable funcNode;
    GLOBAL SET the variable g_node TO the value of funcNode;
    CALL mapGet WITH "moduleId", the value of g_node;
    LET the variable functionModuleId BE the RESPONSE;
    IF the length of functionModuleId IS greater than the number 0 THEN
        GLOBAL SET the variable g_currentModuleId TO the value of functionModuleId;
    END IF;
    
    LET the variable funcName BE the value of name in g_node;
    LET the variable params BE the value of params in g_node;
    LET the variable body BE the value of body in g_node;
    LET the variable ownerClass BE the value of ownerClass in g_node;
    LET the variable symbol BE the value of funcName;
    IF the length of ownerClass IS greater than the number 0 THEN
        GLOBAL SET the variable g_currentClass TO the value of ownerClass;
        SET the variable symbol TO the string "ms_class_" plus the value of ownerClass plus the string "_" plus the value of funcName;
    ELSE
        GLOBAL SET the variable g_currentClass TO the string "";
        CALL privateSymbolStorage WITH the value of funcName, the string "Function";
        LET the variable privateFunctionSymbol BE the RESPONSE;
        IF the length of privateFunctionSymbol IS greater than the number 0 THEN
            SET the variable symbol TO the value of privateFunctionSymbol;
        END IF;
    END IF;

    CALL emit WITH the string "Value " plus the value of symbol plus the string "(Environment& parent_env, const std::vector<Value>& args) {";
    CALL indent WITH the number 0;
    CALL emit WITH "Environment env(parent_env);";

    LET the variable argOffset BE the number 0;
    IF the length of ownerClass IS greater than the number 0 THEN
        CALL emit WITH the string "env.set(" plus the value of QUOTE plus the string "this" plus the value of QUOTE plus the string ", args.at(0));";
        SET the variable argOffset TO the number 1;
    END IF;
    
    IF the value of params IS not equal to the string "" THEN
        LET the variable paramSize BE the size of params;
        LET the variable parameterIndex BE the number 0;
        WHILST the value of parameterIndex IS less than the value of paramSize DO
            CALL getItem WITH the value of parameterIndex, the value of params;
            LET the variable paramName BE the RESPONSE;
            CALL trim WITH the value of paramName;
            LET the variable trimmedParam BE the RESPONSE;
            LET the variable argumentIndex BE the value of parameterIndex plus the value of argOffset;
            CALL buildEnvSet WITH the value of trimmedParam, the string "args.at(static_cast<size_t>(" plus the value of argumentIndex plus the string "))";
            LET the variable paramLine BE the RESPONSE;
            CALL emit WITH the value of paramLine;
            SET the variable parameterIndex TO the value of parameterIndex plus the number 1;
        END WHILST;
    END IF;
    
    LET the variable bodySize BE the size of body;
    LET the variable functionBodyIndex BE the number 0;
    WHILST the value of functionBodyIndex IS less than the value of bodySize DO
        CALL getItem WITH the value of functionBodyIndex, the value of body;
        LET the variable child BE the RESPONSE;
        CALL compileNode WITH the value of child;
        SET the variable functionBodyIndex TO the value of functionBodyIndex plus the number 1;
    END WHILST;
    
    CALL emit WITH "return Value::from_double(0);";
    CALL dedent WITH the number 0;
    CALL emit WITH "}";
    CALL emit WITH "";
    GLOBAL SET the variable g_currentClass TO the string "";
    RETURN the number 0;
END FUNCTION;

DEFINE function compileFieldInitializer WITH the variable className, the variable fieldNode;
    CALL mapGet WITH "moduleId", the value of fieldNode;
    LET the variable fieldModuleId BE the RESPONSE;
    IF the length of fieldModuleId IS greater than the number 0 THEN
        GLOBAL SET the variable g_currentModuleId TO the value of fieldModuleId;
    END IF;
    CALL mapGet WITH "name", the value of fieldNode;
    LET the variable fieldName BE the RESPONSE;
    CALL mapGet WITH "value", the value of fieldNode;
    LET the variable fieldValue BE the RESPONSE;
    LET the variable symbol BE the string "ms_field_" plus the value of className plus the string "_" plus the value of fieldName;
    GLOBAL SET the variable g_currentClass TO the string "";
    CALL emit WITH the string "Value " plus the value of symbol plus the string "(Environment& env) {";
    CALL indent WITH the number 0;
    CALL compileExpr WITH the value of fieldValue;
    LET the variable compiledValue BE the value of g_compiled;
    CALL emit WITH the string "return " plus the value of compiledValue plus the string ";";
    CALL dedent WITH the number 0;
    CALL emit WITH "}";
    CALL emit WITH "";
    RETURN the number 0;
END FUNCTION;

DEFINE function expandImports WITH the variable sourceText;
    LET the variable moduleId BE the string "module_m";
    LET the variable moduleSuffixCount BE the value of g_moduleCounter;
    WHILST the value of moduleSuffixCount IS greater than the number 0 DO
        SET the variable moduleId TO the value of moduleId plus the string "x";
        SET the variable moduleSuffixCount TO the value of moduleSuffixCount minus the number 1;
    END WHILST;
    GLOBAL SET the variable g_moduleCounter TO the value of g_moduleCounter plus the number 1;
    CALL split WITH the value of sourceText, the string "\n";
    LET the variable sourceLines BE the RESPONSE;
    LET the variable sourceLineCount BE the size of sourceLines;
    LET the variable lineIndex BE the number 0;
    LET the variable expandedLines BE [];

    WHILST the value of lineIndex IS less than the value of sourceLineCount DO
        CALL getItem WITH the value of lineIndex, the value of sourceLines;
        LET the variable sourceLine BE the RESPONSE;
        CALL trim WITH the value of sourceLine;
        LET the variable trimmedLine BE the RESPONSE;
        CALL startsWith WITH the value of trimmedLine, the string "IMPORT";
        LET the variable isImport BE the RESPONSE;
        IF the value of isImport IS equal to the number 1 THEN
            CALL extractImportPath WITH the value of trimmedLine;
            LET the variable rawPath BE the RESPONSE;
            CALL replace WITH the value of rawPath, the string ";", the string "";
            LET the variable pathWithoutTerminator BE the RESPONSE;
            CALL trim WITH the value of pathWithoutTerminator;
            LET the variable trimmedPath BE the RESPONSE;
            CALL stripQuotes WITH the value of trimmedPath;
            LET the variable importPath BE the RESPONSE;

            LET the variable alreadyImported BE the number 0;
            LET the variable importedIndex BE the number 0;
            LET the variable importedCount BE the size of g_importedFiles;
            WHILST the value of importedIndex IS less than the value of importedCount DO
                CALL getItem WITH the value of importedIndex, the value of g_importedFiles;
                LET the variable existingPath BE the RESPONSE;
                IF the value of existingPath IS equal to the value of importPath THEN
                    SET the variable alreadyImported TO the number 1;
                END IF;
                SET the variable importedIndex TO the value of importedIndex plus the number 1;
            END WHILST;

            IF the value of alreadyImported IS equal to the number 0 THEN
                CALL startsWith WITH the value of importPath, the string "stdlib/";
                LET the variable isStandardLibrary BE the RESPONSE;
                IF the value of isStandardLibrary IS equal to the number 0 THEN
                    CALL append WITH the value of importPath, the value of g_importedFiles;
                    GLOBAL SET the variable g_importedFiles TO the RESPONSE;
                    CALL readFile WITH the value of importPath;
                    LET the variable importedSource BE the RESPONSE;
                    CALL expandImports WITH the value of importedSource;
                    LET the variable expandedImport BE the RESPONSE;
                    CALL append WITH the value of expandedImport, the value of expandedLines;
                    SET the variable expandedLines TO the RESPONSE;
                END IF;
            END IF;
        ELSE
            CALL append WITH the value of sourceLine, the value of expandedLines;
            SET the variable expandedLines TO the RESPONSE;
            CALL append WITH the value of moduleId, the value of g_expandedModuleIds;
            GLOBAL SET the variable g_expandedModuleIds TO the RESPONSE;
        END IF;
        SET the variable lineIndex TO the value of lineIndex plus the number 1;
    END WHILST;
    CALL join WITH the value of expandedLines, the string "\n";
    LET the variable expandedSource BE the RESPONSE;
    RETURN the value of expandedSource;
END FUNCTION;

^ ====== Main: Parse source, generate C++ ======
^ Check command-line arguments for file path, otherwise use default
LET the variable argCount BE the size of ARGV;
LET the variable filePath BE "examples/hello.mish";
IF the value of argCount IS greater than the number 0 THEN
    CALL getItem WITH the number 0, the value of ARGV;
    SET the variable filePath TO the RESPONSE;
END IF;
PROCLAIM the string "Compiling: ";
PROCLAIM the value of filePath;
PROCLAIM the string "";

LET the variable source BE the content of the file the value of filePath;
GLOBAL SET the variable g_importedFiles TO [];
GLOBAL SET the variable g_expandedModuleIds TO [];
GLOBAL SET the variable g_moduleCounter TO the number 0;
CALL expandImports WITH the value of source;
SET the variable source TO the RESPONSE;
CALL split WITH the value of source, the string "\n";
LET the variable sourceLines BE the RESPONSE;

GLOBAL SET the variable g_lines TO the value of sourceLines;
GLOBAL SET the variable g_lineModuleIds TO the value of g_expandedModuleIds;
GLOBAL SET the variable g_pos TO the number 0;
GLOBAL SET the variable g_lineCount TO the size of g_lines;
GLOBAL SET the variable g_myAst TO [];

WHILST the value of g_pos IS less than the value of g_lineCount DO
    CALL parseStatement WITH the number 0;
    LET the variable node BE the value of g_result;
    CALL mapGet WITH "type", the value of node;
    LET the variable nodeType BE the RESPONSE;
    IF the value of nodeType IS not equal to the string "Empty" THEN
        IF the value of nodeType IS not equal to the string "Comment" THEN
            CALL append WITH the value of node, the value of g_myAst;
            LET the variable newAst BE the RESPONSE;
            GLOBAL SET the variable g_myAst TO the value of newAst;
        END IF;
    END IF;
END WHILST;

SET the variable g_output TO [];
SET the variable g_indent TO the number 0;
SET the variable g_functions TO [];
SET the variable g_classes TO [];
SET the variable g_mainStmts TO [];
GLOBAL SET the variable g_moduleDeclarations TO {};
GLOBAL SET the variable g_privateStorage TO {};
GLOBAL SET the variable g_privateSymbols TO [];

LET the variable astSize BE the size of g_myAst;
GLOBAL SET the variable g_idx TO the number 0;
WHILST the value of g_idx IS less than the value of astSize DO
    CALL getItem WITH the value of g_idx, the value of g_myAst;
    LET the variable node BE the RESPONSE;
    CALL mapGet WITH "type", the value of node;
    LET the variable nodeType BE the RESPONSE;
    LET the variable moduleSymbolKind BE the string "";
    IF the value of nodeType IS equal to the string "Let" THEN
        SET the variable moduleSymbolKind TO the string "Variable";
    END IF;
    IF the value of nodeType IS equal to the string "FunctionDef" THEN
        CALL mapGet WITH "ownerClass", the value of node;
        LET the variable functionOwnerClass BE the RESPONSE;
        IF the length of functionOwnerClass IS equal to the number 0 THEN
            SET the variable moduleSymbolKind TO the string "Function";
        END IF;
    END IF;
    IF the value of nodeType IS equal to the string "ClassDef" THEN
        SET the variable moduleSymbolKind TO the string "Class";
    END IF;
    IF the length of moduleSymbolKind IS greater than the number 0 THEN
        CALL mapGet WITH "name", the value of node;
        LET the variable moduleSymbolName BE the RESPONSE;
        CALL mapGet WITH "moduleId", the value of node;
        LET the variable moduleSymbolModule BE the RESPONSE;
        CALL mapGet WITH "visibility", the value of node;
        LET the variable moduleSymbolVisibility BE the RESPONSE;
        CALL moduleSymbolKey WITH the value of moduleSymbolModule, the value of moduleSymbolKind, the value of moduleSymbolName;
        LET the variable moduleSymbolKeyValue BE the RESPONSE;
        SET the key moduleSymbolKeyValue IN the map g_moduleDeclarations TO the number 1;
        IF the value of moduleSymbolVisibility IS equal to the string "Private" THEN
            LET the variable privateAlias BE the string "__ms_private_" plus the value of moduleSymbolModule plus the string "_" plus the value of moduleSymbolName;
            SET the key moduleSymbolKeyValue IN the map g_privateStorage TO the value of privateAlias;
            LET the variable privateSymbol BE {};
            SET the key "name" IN the map privateSymbol TO the value of moduleSymbolName;
            SET the key "kind" IN the map privateSymbol TO the value of moduleSymbolKind;
            SET the key "moduleId" IN the map privateSymbol TO the value of moduleSymbolModule;
            CALL append WITH the value of privateSymbol, the value of g_privateSymbols;
            GLOBAL SET the variable g_privateSymbols TO the RESPONSE;
        END IF;
    END IF;
    IF the value of nodeType IS equal to the string "FunctionDef" THEN
        CALL append WITH the value of node, the value of g_functions;
        LET the variable newFuncs2 BE the RESPONSE;
        GLOBAL SET the variable g_functions TO the value of newFuncs2;
    ELSE
        IF the value of nodeType IS equal to the string "ClassDef" THEN
            CALL append WITH the value of node, the value of g_classes;
            LET the variable newClasses BE the RESPONSE;
            GLOBAL SET the variable g_classes TO the value of newClasses;
        ELSE
            CALL append WITH the value of node, the value of g_mainStmts;
            LET the variable newMain2 BE the RESPONSE;
            GLOBAL SET the variable g_mainStmts TO the value of newMain2;
        END IF;
    END IF;
    GLOBAL SET the variable g_idx TO the value of g_idx plus the number 1;
END WHILST;

^ Collect class methods with top-level functions for definition generation.
LET the variable classIndex BE the number 0;
LET the variable classCount BE the size of g_classes;
WHILST the value of classIndex IS less than the value of classCount DO
    CALL getItem WITH the value of classIndex, the value of g_classes;
    LET the variable classNode BE the RESPONSE;
    CALL mapGet WITH "members", the value of classNode;
    LET the variable classMembers BE the RESPONSE;
    LET the variable memberIndex BE the number 0;
    LET the variable memberCount BE the size of classMembers;
    WHILST the value of memberIndex IS less than the value of memberCount DO
        CALL getItem WITH the value of memberIndex, the value of classMembers;
        LET the variable memberNode BE the RESPONSE;
        CALL mapGet WITH "type", the value of memberNode;
        LET the variable classMemberType BE the RESPONSE;
        IF the value of classMemberType IS equal to the string "FunctionDef" THEN
            CALL append WITH the value of memberNode, the value of g_functions;
            GLOBAL SET the variable g_functions TO the RESPONSE;
        END IF;
        SET the variable memberIndex TO the value of memberIndex plus the number 1;
    END WHILST;
    SET the variable classIndex TO the value of classIndex plus the number 1;
END WHILST;

SET the variable g_functionNames TO {};
LET the variable functionNameIndex BE the number 0;
LET the variable functionNameCount BE the size of g_functions;
WHILST the value of functionNameIndex IS less than the value of functionNameCount DO
    CALL getItem WITH the value of functionNameIndex, the value of g_functions;
    LET the variable functionNode BE the RESPONSE;
    CALL mapGet WITH "name", the value of functionNode;
    LET the variable functionName BE the RESPONSE;
    CALL mapGet WITH "ownerClass", the value of functionNode;
    LET the variable functionOwnerClass BE the RESPONSE;
    IF the length of functionOwnerClass IS equal to the number 0 THEN
        SET the key functionName IN the map g_functionNames TO the number 1;
    END IF;
    SET the variable functionNameIndex TO the value of functionNameIndex plus the number 1;
END WHILST;

CALL split WITH the string "println,greet,add_and_print,repeat,min,max,abs,round,toupper,tolower,startsWith,endsWith,isDigit,isLetter,isWhitespace,readFile,length,charAt,substring,split,join,trim,replace,size,append,getItem,mapSet,mapGet,indexOf", the string ",";
LET the variable standardFunctionNames BE the RESPONSE;
SET the variable g_standardFunctionNames TO {};
LET the variable standardFunctionIndex BE the number 0;
LET the variable standardFunctionCount BE the size of standardFunctionNames;
WHILST the value of standardFunctionIndex IS less than the value of standardFunctionCount DO
    CALL getItem WITH the value of standardFunctionIndex, the value of standardFunctionNames;
    LET the variable standardFunctionName BE the RESPONSE;
    SET the key standardFunctionName IN the map g_standardFunctionNames TO the number 1;
    SET the variable standardFunctionIndex TO the value of standardFunctionIndex plus the number 1;
END WHILST;

^ Generate C++ header
CALL emit WITH the string "#include " plus the value of QUOTE plus the string "midshake_runtime.hpp" plus the value of QUOTE;
CALL emit WITH "using namespace ms;";
CALL emit WITH "";

^ Generate function definitions
LET the variable fieldClassIndex BE the number 0;
LET the variable fieldClassCount BE the size of g_classes;
WHILST the value of fieldClassIndex IS less than the value of fieldClassCount DO
    CALL getItem WITH the value of fieldClassIndex, the value of g_classes;
    LET the variable fieldClassNode BE the RESPONSE;
    CALL mapGet WITH "name", the value of fieldClassNode;
    LET the variable fieldClassName BE the RESPONSE;
    CALL mapGet WITH "members", the value of fieldClassNode;
    LET the variable fieldMembers BE the RESPONSE;
    LET the variable fieldMemberIndex BE the number 0;
    LET the variable fieldMemberCount BE the size of fieldMembers;
    WHILST the value of fieldMemberIndex IS less than the value of fieldMemberCount DO
        CALL getItem WITH the value of fieldMemberIndex, the value of fieldMembers;
        LET the variable fieldNode BE the RESPONSE;
        CALL mapGet WITH "type", the value of fieldNode;
        LET the variable fieldNodeType BE the RESPONSE;
        IF the value of fieldNodeType IS equal to the string "Let" THEN
            CALL compileFieldInitializer WITH the value of fieldClassName, the value of fieldNode;
        END IF;
        SET the variable fieldMemberIndex TO the value of fieldMemberIndex plus the number 1;
    END WHILST;
    SET the variable fieldClassIndex TO the value of fieldClassIndex plus the number 1;
END WHILST;

LET the variable funcCount BE the size of g_functions;
GLOBAL SET the variable g_idx TO the number 0;
WHILST the value of g_idx IS less than the value of funcCount DO
    CALL getItem WITH the value of g_idx, the value of g_functions;
    LET the variable funcNode BE the RESPONSE;
    CALL compileFunctionDef WITH the value of funcNode;
    GLOBAL SET the variable g_idx TO the value of g_idx plus the number 1;
END WHILST;

^ Generate main function with command-line argument support
CALL emit WITH "int main(int argc, char* argv[]) {";
CALL indent WITH the number 0;
CALL emit WITH "try {";
CALL indent WITH the number 0;
CALL emit WITH "Environment env(argc, argv);";

^ Register class inheritance before any instances can be created.
LET the variable registerClassIndex BE the number 0;
LET the variable registerClassCount BE the size of g_classes;
WHILST the value of registerClassIndex IS less than the value of registerClassCount DO
    CALL getItem WITH the value of registerClassIndex, the value of g_classes;
    LET the variable registerClassNode BE the RESPONSE;
    CALL mapGet WITH "name", the value of registerClassNode;
    LET the variable registerClassName BE the RESPONSE;
    CALL mapGet WITH "baseName", the value of registerClassNode;
    LET the variable registerBaseName BE the RESPONSE;
    CALL emit WITH the string "register_class(" plus the value of QUOTE plus the value of registerClassName plus the value of QUOTE plus the string ", " plus the value of QUOTE plus the value of registerBaseName plus the value of QUOTE plus the string ");";
    SET the variable registerClassIndex TO the value of registerClassIndex plus the number 1;
END WHILST;

LET the variable registerMemberClassIndex BE the number 0;
WHILST the value of registerMemberClassIndex IS less than the value of registerClassCount DO
    CALL getItem WITH the value of registerMemberClassIndex, the value of g_classes;
    LET the variable registerMemberClass BE the RESPONSE;
    CALL mapGet WITH "name", the value of registerMemberClass;
    LET the variable registerMemberClassName BE the RESPONSE;
    CALL mapGet WITH "members", the value of registerMemberClass;
    LET the variable registerMembers BE the RESPONSE;
    LET the variable registerMemberIndex BE the number 0;
    LET the variable registerMemberCount BE the size of registerMembers;
    WHILST the value of registerMemberIndex IS less than the value of registerMemberCount DO
        CALL getItem WITH the value of registerMemberIndex, the value of registerMembers;
        LET the variable registerMember BE the RESPONSE;
        CALL mapGet WITH "type", the value of registerMember;
        LET the variable registerMemberType BE the RESPONSE;
        CALL mapGet WITH "name", the value of registerMember;
        LET the variable registerMemberName BE the RESPONSE;
        CALL mapGet WITH "visibility", the value of registerMember;
        LET the variable registerVisibility BE the RESPONSE;
        CALL accessLevel WITH the value of registerVisibility;
        LET the variable registerAccess BE the RESPONSE;
        IF the value of registerMemberType IS equal to the string "Let" THEN
            LET the variable fieldSymbol BE the string "ms_field_" plus the value of registerMemberClassName plus the string "_" plus the value of registerMemberName;
            CALL emit WITH the string "register_class_field(" plus the value of QUOTE plus the value of registerMemberClassName plus the value of QUOTE plus the string ", " plus the value of QUOTE plus the value of registerMemberName plus the value of QUOTE plus the string ", " plus the value of registerAccess plus the string ", &" plus the value of fieldSymbol plus the string ");";
        ELSE
            IF the value of registerMemberType IS equal to the string "FunctionDef" THEN
                CALL mapGet WITH "params", the value of registerMember;
                LET the variable registerMethodParams BE the RESPONSE;
                LET the variable methodArity BE the size of registerMethodParams;
                LET the variable methodSymbol BE the string "ms_class_" plus the value of registerMemberClassName plus the string "_" plus the value of registerMemberName;
                CALL classConstructorCallsBase WITH the value of registerMemberClass;
                LET the variable methodCallsBase BE the RESPONSE;
                IF the value of methodCallsBase IS equal to the number 1 THEN
                    LET the variable callsBaseLiteral BE the string "true";
                ELSE
                    LET the variable callsBaseLiteral BE the string "false";
                END IF;
                CALL emit WITH the string "register_class_method(" plus the value of QUOTE plus the value of registerMemberClassName plus the value of QUOTE plus the string ", " plus the value of QUOTE plus the value of registerMemberName plus the value of QUOTE plus the string ", " plus the value of registerAccess plus the string ", " plus the value of methodArity plus the string ", " plus the value of callsBaseLiteral plus the string ", &" plus the value of methodSymbol plus the string ");";
            END IF;
        END IF;
        SET the variable registerMemberIndex TO the value of registerMemberIndex plus the number 1;
    END WHILST;
    SET the variable registerMemberClassIndex TO the value of registerMemberClassIndex plus the number 1;
END WHILST;

LET the variable mainCount BE the size of g_mainStmts;
GLOBAL SET the variable g_idx TO the number 0;
WHILST the value of g_idx IS less than the value of mainCount DO
    CALL getItem WITH the value of g_idx, the value of g_mainStmts;
    LET the variable stmt BE the RESPONSE;
    CALL compileNode WITH the value of stmt;
    GLOBAL SET the variable g_idx TO the value of g_idx plus the number 1;
END WHILST;

CALL emit WITH "return 0;";
CALL dedent WITH the number 0;
CALL emit WITH "} catch (const ThrownValue& thrown) {";
CALL indent WITH the number 0;
CALL emit WITH the string "std::cerr << " plus the value of QUOTE plus the string "Uncaught MidShake exception: " plus the value of QUOTE plus the string " << thrown.value.to_string() << std::endl;";
CALL emit WITH "return 1;";
CALL dedent WITH the number 0;
CALL emit WITH "}";
CALL dedent WITH the number 0;
CALL emit WITH "}";

^ Join output lines
CALL join WITH the value of g_output, the string "\n";
LET the variable cppOutput BE the RESPONSE plus the string "\n";

IN the file "build/output/generated.cpp" WRITE the value of cppOutput;

PROCLAIM the string "";
PROCLAIM the string "Generated C++ code written to build/output/generated.cpp";
PROCLAIM the string "";
PROCLAIM the string "Compilation complete!";
