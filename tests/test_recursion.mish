^ Test recursion support
IMPORT the file "stdlib/stdlib.mish";

DEFINE function factorial WITH the variables n
    IF the value of n IS less than or equal to the number 1 THEN
        RETURN the number 1;
    END IF;
    CALL factorial WITH the value of n minus the number 1;
    LET the variable result BE the RESPONSE;
    RETURN the value of n times the value of result;
END FUNCTION;

PROCLAIM the string "Factorial of 5: ";
CALL factorial WITH the number 5;
PROCLAIM the RESPONSE;

PROCLAIM the string "Factorial of 10: ";
CALL factorial WITH the number 10;
PROCLAIM the RESPONSE;

PROCLAIM the string "Recursion works!";
